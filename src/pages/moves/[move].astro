---
import Layout from '../../layouts/Layout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import movesDataJson from '../../lib/data/moves-data.json'
import movesMetaJson from '../../lib/data/moves-meta.json'
import { typeBadge } from '../../ui/badges'
import { categoryBadge } from '../../ui/category-badge'
import { titleize, moveCardStyle, genChip } from '../../ui/move-card'
import { moveGenTable, type MoveGenTableInput, type MovePastChange } from '../../ui/move-gen-table'

interface RawMove { power: number | null; accuracy: number | null; pp: number; type: string; damage_class: string; effect: string }
interface MoveMeta { gen: number; effect_chance?: number; past?: MovePastChange[] }
export interface Props { slug: string; move: RawMove; meta: MoveMeta }

// getStaticPaths runs in an isolated scope at build time — it can only see
// imports, so it builds its own merged list here (same gotcha as games/[game].astro)
export function getStaticPaths() {
    const moves = movesDataJson as unknown as Record<string, RawMove>
    const metas = movesMetaJson as unknown as Record<string, MoveMeta>
    return Object.keys(metas)
        .filter((slug) => moves[slug])
        .map((slug) => ({ params: { move: slug }, props: { slug, move: moves[slug], meta: metas[slug] } }))
}

const base = import.meta.env.BASE_URL
const { slug, move, meta } = Astro.props

const name = titleize(slug)
const effect = move.effect.replace(/\$effect_chance/g, String(meta.effect_chance ?? ''))
const genTable = moveGenTable({
    gen: meta.gen,
    type: move.type,
    damage_class: move.damage_class as MoveGenTableInput['damage_class'],
    power: move.power,
    accuracy: move.accuracy,
    pp: move.pp,
    past: meta.past,
})

const statBlocks = [
    { label: 'Power', value: move.power ?? '—' },
    { label: 'Accuracy', value: move.accuracy != null ? `${move.accuracy}%` : '—' },
    { label: 'PP', value: move.pp },
]

const description = `${name} — ${move.type}-type ${move.damage_class} move. ${effect}`.slice(0, 160)
---

<Layout title={`${name} — Moves | PokeBasic`} description={description} canonicalPath={`/moves/${slug}`}>
    <SiteHeader subtitle="Move Dex" activeRoute="/moves" />

    <main class="max-w-6xl mx-auto px-4 py-6">

        <a href={`${base}/moves`} class="inline-flex items-center gap-1 text-xs font-bold text-text-tertiary hover:text-action transition mb-4">
            ← All moves
        </a>

        <div x-data="moveDetail" data-move={slug} data-effect={effect} class="grid gap-5 lg:grid-cols-[7fr_3fr] items-start">

            <!-- ══════════ LEFT COLUMN (70%) ══════════ -->
            <div class="space-y-5 min-w-0">

                <!-- HERO — same skin as the listing cards -->
                <div class="rounded-2xl border border-border-subtle shadow-sm p-6" style={moveCardStyle(move.type, move.damage_class)}>
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <h1 class="text-3xl font-black text-text-primary mb-3">{name}</h1>
                            <div class="flex items-center gap-2 flex-wrap">
                                <Fragment set:html={typeBadge(move.type, 'md')} />
                                <Fragment set:html={categoryBadge(move.damage_class, base, 'md')} />
                            </div>
                        </div>
                        <Fragment set:html={genChip(meta.gen)} />
                    </div>
                </div>

                <!-- STAT ISLANDS -->
                <div class="grid grid-cols-3 gap-3">
                    {statBlocks.map((s) => (
                        <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-4 text-center">
                            <div class="text-[10px] font-black text-text-tertiary uppercase tracking-widest mb-1">{s.label}</div>
                            <div class="text-2xl font-black text-text-primary">{s.value}</div>
                        </div>
                    ))}
                </div>

                <!-- EFFECT -->
                <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5">
                    <div class="flex items-center gap-2.5 mb-3">
                        <div class="w-8 h-8 rounded-full bg-action-subtle flex items-center justify-center shrink-0 text-action font-black text-sm">ℹ</div>
                        <h2 class="font-black text-text-primary text-sm">Effect</h2>
                    </div>
                    <p class="text-sm text-text-secondary font-medium">{effect}</p>
                    <div x-show="hasTechnical" x-cloak class="bg-bg-elevated rounded-xl p-3.5 mt-4">
                        <p class="text-[10px] font-black text-text-tertiary uppercase tracking-widest mb-1.5">Technical</p>
                        <p class="text-xs text-text-secondary font-medium leading-relaxed whitespace-pre-line" x-text="longEffect"></p>
                    </div>
                </div>

                <!-- CROSS-GEN HISTORY -->
                {genTable && (
                    <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5">
                        <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-1">Across Generations</p>
                        <p class="text-xs text-text-tertiary mb-3">
                            Values that changed over time are <span class="text-amber-600 dark:text-amber-400 font-black">highlighted</span>.
                            Before Gen IV, a move's category was determined by its type.
                        </p>
                        <Fragment set:html={genTable} />
                    </div>
                )}

            </div>

            <!-- ══════════ RIGHT COLUMN (30%) — LEARNED BY ══════════ -->
            <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5 lg:sticky lg:top-4 h-fit min-w-0">
                <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-3">
                    Learned by <span x-show="!loading && !failed" x-cloak>(<span x-text="learners.length"></span> Pokémon)</span>
                </p>

                <div x-show="loading" class="flex items-center gap-3 py-4">
                    <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-action"></div>
                    <span class="text-sm text-text-tertiary font-semibold">Loading learners…</span>
                </div>

                <p x-show="failed" x-cloak class="text-sm text-text-tertiary font-semibold py-2">
                    Couldn't load the learner list — check your connection and refresh.
                </p>

                <p x-show="!loading && !failed && learners.length === 0" x-cloak class="text-sm text-text-tertiary font-semibold py-2">
                    No Pokémon can learn this move in current games.
                </p>

                <div x-show="!loading && learners.length > 0" x-cloak class="flex flex-wrap gap-1.5 max-h-[70vh] overflow-y-auto pr-1">
                    <template x-for="p in learners" :key="p.id">
                        <button @click="openPokemon(p.name)"
                            class="inline-flex items-center gap-1 pl-1 pr-2.5 py-0.5 rounded-full bg-bg-elevated border border-border-subtle hover:border-action hover:bg-action-subtle text-xs font-semibold text-text-secondary hover:text-action transition">
                            <img :src="`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${p.id}.png`"
                                :alt="p.name" loading="lazy" class="w-6 h-6" style="image-rendering:pixelated">
                            <span x-text="capitalize(p.name)"></span>
                        </button>
                    </template>
                </div>
            </div>

        </div>

    </main>
</Layout>
