---
import Layout from '../../layouts/Layout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import { GUIDE_REGISTRY, type GuideRegistration } from '../../lib/data/guides/registry'
import GuideLocationDetails from '../../components/guides/GuideLocationDetails.astro'
import GuideFishingDetails from '../../components/guides/GuideFishingDetails.astro'
import GuideOptionalLocation from '../../components/guides/GuideOptionalLocation.astro'
import GuideSectionIcon from '../../components/guides/GuideSectionIcon.astro'
import GuideStopIcon from '../../components/guides/GuideStopIcon.astro'
import { buildGuideCollectionManifest } from '../../lib/data/guides/collection-manifest'

export function getStaticPaths() {
    return GUIDE_REGISTRY.map((entry) => ({
        params: { game: entry.game.id },
        props: { entry },
    }))
}

interface Props { entry: GuideRegistration }
const { entry } = Astro.props
const { game } = entry
const collectionManifest = buildGuideCollectionManifest(entry)
const base = import.meta.env.BASE_URL
---

<Layout
    title={`PokeBasic — ${game.title} Guide`}
    description={`Step-by-step walkthrough for Pokémon ${game.title}. Items, wild Pokémon, gym teams, Elite Four strategy, and progress tracking.`}
>
    <SiteHeader subtitle={`Game Guide · Gen ${game.gen}`} activeRoute="/games" />

    <!-- ══════════ MAIN ══════════ -->
    <div x-data="guide" data-game={JSON.stringify(game)} data-collection={collectionManifest ? JSON.stringify(collectionManifest) : undefined} x-cloak class="max-w-7xl mx-auto px-4 py-6">

        <!-- Page title + game switcher -->
        <div class="mb-5 flex flex-col sm:flex-row sm:items-end gap-4">
            <div>
                <h1 class="text-2xl font-black text-text-primary mb-1">📖 {game.title} Guide</h1>
                <p class="text-sm text-text-tertiary font-medium">Step-by-step walkthrough. Mark stops as you complete them — progress saves automatically.</p>
            </div>
            <div class="flex gap-2 sm:ml-auto flex-wrap">
                {GUIDE_REGISTRY.map(({ game: g, coverage }) => (
                    <div class="flex items-center gap-1.5">
                        <a href={`${base}/games/${g.id}`} class:list={['fchip', g.id === game.id && 'fchip-active']}>
                            {g.title}
                        </a>
                        <span class="text-[10px] font-black uppercase tracking-wide px-2 py-0.5 rounded-full border bg-amber-100 text-amber-700 border-amber-200">
                            {coverage === 'main-story' ? 'Main story guide' : coverage === 'partial' ? 'Partial guide' : 'Story outline'}
                        </span>
                    </div>
                ))}
            </div>
        </div>

        <section aria-label="About this guide" class="bg-bg-surface rounded-2xl border border-border-subtle p-4 mb-5 text-sm text-text-secondary">
            {game.id === 'red-blue'
                ? <p><strong>Main story route complete.</strong> The 24 stops take you from Pallet Town to the Hall of Fame. Some optional trainers, items, encounters and activities are still being checked.</p>
                : <p><strong>Guide in progress.</strong> Some details are still being checked, and not every item, encounter or optional activity is listed.</p>}
            {game.id === 'red-blue' && <p class="mt-2 text-xs">For the original English Game Boy Red/Blue, not Yellow or remakes.</p>}
        </section>

        <!-- Progress bar -->
        <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-4 mb-5">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="text-xs font-black text-text-tertiary uppercase tracking-widest">Progress</span>
                <span class="text-xs font-bold text-text-secondary" x-text="`${completedStops.length} / ${game.stops.length} stops completed`"></span>
            </div>
            <div class="stat-bar-track" role="progressbar" aria-label="Guide stops completed" aria-valuemin="0" :aria-valuenow="completedStops.length" :aria-valuemax="game.stops.length">
                <div class="stat-bar-fill bg-action transition-all duration-300" :style="`width:${progressPct}%`"></div>
            </div>
            <div x-show="collectionManifest" x-cloak class="mt-3 border-t border-border-subtle pt-3 text-xs text-text-secondary">
                <p class="font-bold">Separate checklist: <span x-text="`${collectionState.completedSteps.length}/${collectionTotals.steps} steps · ${collectionState.collectedItems.length}/${collectionTotals.items} listed items · ${collectionState.seenSpecies.length}/${collectionTotals.species} seen · ${collectionState.caughtSpecies.length}/${collectionTotals.species} caught`"></span></p>
                <p class="mt-1">These are guide-listed entries across Red and Blue, not a complete Pokédex or item inventory. Some item choices are alternatives.</p>
            </div>
            <div class="flex flex-wrap justify-end items-center gap-2 mt-3">
                <button type="button" @click="downloadBackup()" title="JSON backup for this guide, including recovery snapshots and current unsaved edits." class="min-h-9 px-3 py-2 rounded-lg bg-action-subtle text-xs font-bold text-action hover:underline focus-visible:outline-2 focus-visible:outline-action">Download save backup</button>
                <button type="button" @click="resetProgress()" class="min-h-9 px-3 py-2 rounded-lg text-xs font-bold text-text-secondary hover:text-brand hover:bg-bg-elevated transition focus-visible:outline-2 focus-visible:outline-action">✕ Reset</button>
            </div>
            <details class="mt-4 border-t border-border-subtle pt-3 text-sm text-text-secondary">
                <summary class="cursor-pointer font-bold text-action">Restore a guide backup</summary>
                <div class="mt-3 space-y-3">
                    <p>Choose a JSON backup for this guide. Review its saved values and its separate tab view before restoring. Older backups restore story progress and starter choice while leaving the collection checklist as it is.</p>
                    <label class="block font-semibold" for="guide-restore-file">Backup file</label>
                    <input id="guide-restore-file" type="file" accept=".json,application/json" @change="prepareRestoreFile($event)" class="block w-full max-w-full text-sm" />
                    <div x-show="restorePreview" x-cloak class="space-y-3 rounded-xl border border-border-subtle bg-bg-elevated p-3">
                        <p class="font-semibold">Backup from <span x-text="restorePreview?.exportedAt ? new Date(restorePreview.exportedAt).toLocaleString() : ''"></span></p>
                        <fieldset class="space-y-1">
                            <legend class="font-semibold">Which values should be restored?</legend>
                            <label class="flex items-start gap-2"><input type="radio" name="guide-restore-source" value="saved" x-model="restoreSource" :disabled="!restorePreview?.saved" /><span x-text="restorePreview?.saved ? `Saved values: ${restorePreview.saved.completedStops.length} completed stops; starter ${restorePreview.saved.selectedStarter?.name ?? 'none'}${restorePreview.saved.collection ? `; ${restorePreview.saved.collection.collectedItems.length} listed items` : ''}` : 'Saved values cannot be safely restored from this file'"></span></label>
                            <label class="flex items-start gap-2"><input type="radio" name="guide-restore-source" value="session" x-model="restoreSource" :disabled="!restorePreview?.session" /><span x-text="restorePreview?.session ? `Tab view: ${restorePreview.session.completedStops.length} completed stops; starter ${restorePreview.session.selectedStarter?.name ?? 'none'}${restorePreview.session.collection ? `; ${restorePreview.session.collection.collectedItems.length} listed items` : ''}` : 'No separate tab view in this file'"></span></label>
                        </fieldset>
                        <fieldset class="space-y-1">
                            <legend class="font-semibold">How should it combine with this guide?</legend>
                            <label class="flex items-start gap-2"><input type="radio" name="guide-restore-mode" value="replace" x-model="restoreMode" /><span>Replace this guide's progress, starter and included collection checklist with the chosen values.</span></label>
                            <label class="flex items-start gap-2"><input type="radio" name="guide-restore-mode" value="merge" x-model="restoreMode" /><span>Keep marked entries from both saves. Keep the current starter if one is selected.</span></label>
                        </fieldset>
                        <p class="text-xs">Recovery copies are kept. Download your current save before applying this file.</p>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" @click="downloadCurrentBeforeRestore()" class="min-h-9 rounded-lg bg-action-subtle px-3 py-2 font-bold text-action">1. Download current save</button>
                            <button type="button" @click="restoreBackup()" :disabled="!restoreCurrentBackupDownloaded" class="min-h-9 rounded-lg bg-action px-3 py-2 font-bold text-white disabled:opacity-50">2. Restore selected backup</button>
                        </div>
                    </div>
                </div>
            </details>
        </div>

        <section x-show="storageMessages.length > 0" x-cloak role="status" aria-live="polite" aria-label="Guide save status" class="mb-5 rounded-2xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30 p-4 text-sm text-amber-900 dark:text-amber-100 space-y-2">
            <template x-for="message in storageMessages" :key="message"><p x-text="message"></p></template>
        </section>

        <!-- Mobile stop selector -->
        <div class="lg:hidden w-full mb-4">
            <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-3">
                <p class="text-[10px] font-black text-text-tertiary uppercase tracking-widest mb-2">Select Stop</p>
                <div class="flex flex-wrap gap-1.5">
                    <template x-for="stop in game.stops" :key="stop.id">
                        <button
                            @click="selectStop(stop.id)"
                            :class="{
                                'bg-action text-white': activeStopId === stop.id,
                                'bg-bg-elevated text-text-secondary hover:bg-action-subtle': activeStopId !== stop.id,
                                'opacity-60': isCompleted(stop.id) && activeStopId !== stop.id
                            }"
                            class="px-2.5 py-1 rounded-lg text-[11px] font-bold transition flex items-center gap-1">
                            <GuideStopIcon kind="stop.kind" text="stop.icon || stopIcon(stop.kind)" />
                            <span x-text="stop.name"></span>
                        </button>
                    </template>
                </div>
            </div>
        </div>

        <!-- Sidebar + panel layout -->
        <div class="flex flex-col lg:flex-row gap-5 items-start">

            <!-- ══════════ SIDEBAR ══════════ -->
            <aside class="w-56 shrink-0 bg-bg-surface rounded-2xl border border-border-subtle shadow-sm overflow-hidden sticky top-20 max-h-[calc(100vh-6rem)] flex-col max-lg:hidden lg:flex">
                <div class="px-4 py-3 border-b border-border-subtle shrink-0">
                    <p class="text-[10px] font-black text-text-tertiary uppercase tracking-widest" x-text="game.title + ' — ' + game.stops.length + ' stops'"></p>
                </div>
                <nav class="overflow-y-auto flex-1">
                    <template x-for="stop in game.stops" :key="stop.id">
                        <button
                            @click="selectStop(stop.id)"
                            :class="{
                                'bg-action-subtle border-l-4 border-action text-action': activeStopId === stop.id,
                                'border-l-4 border-transparent hover:bg-bg-elevated text-text-secondary': activeStopId !== stop.id
                            }"
                            class="w-full text-left px-3 py-2.5 flex items-center gap-2 transition text-xs font-semibold">
                            <span
                                :class="isCompleted(stop.id) ? 'bg-emerald-500 text-white' : 'bg-bg-raised text-text-tertiary'"
                                class="w-4 h-4 rounded-full flex items-center justify-center text-[9px] shrink-0 font-black">
                                <template x-if="isCompleted(stop.id)">
                                    <span>✓</span>
                                </template>
                            </span>
                            <GuideStopIcon kind="stop.kind" text="stop.icon || stopIcon(stop.kind)" />
                            <span x-text="stop.name" class="leading-tight truncate" :class="isCompleted(stop.id) ? 'line-through text-text-tertiary' : ''"></span>
                        </button>
                    </template>
                </nav>
            </aside>

            <!-- ══════════ MAIN PANEL ══════════ -->
            <main class="flex-1 min-w-0 w-full space-y-4 lg:block" :class="{'hidden': !currentStop}">
                <template x-if="currentStop">
                    <div class="space-y-4">

                        <!-- Stop header -->
                        <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5">
                            <div class="flex items-start justify-between gap-4 flex-wrap">
                                <div>
                                    <div class="flex items-center gap-2 mb-1">
                                        <GuideStopIcon kind="currentStop.kind" text="currentStop.icon || stopIcon(currentStop.kind)" large />
                                        <h2 class="text-xl font-black text-text-primary" x-text="currentStop.name"></h2>
                                    </div>
                                    <span class="text-[11px] font-black text-text-tertiary uppercase tracking-widest px-2 py-0.5 bg-bg-raised rounded-full" x-text="currentStop.kind.replace('-', ' ')"></span>
                                </div>
                                <button
                                    @click="toggleStop(currentStop.id)"
                                    :class="isCompleted(currentStop.id)
                                        ? 'bg-emerald-500 text-white border-emerald-500 hover:bg-red-50 hover:text-red-500 hover:border-red-300'
                                        : 'bg-bg-surface text-text-secondary border-border hover:border-action hover:text-action'"
                                    class="px-4 py-2 rounded-xl border-2 font-bold text-sm transition flex items-center gap-2 shrink-0">
                                    <template x-if="isCompleted(currentStop.id)">
                                        <span>✓ Completed</span>
                                    </template>
                                    <template x-if="!isCompleted(currentStop.id)">
                                        <span>Mark Complete</span>
                                    </template>
                                </button>
                            </div>
                        </div>

                        <!-- Starter picker -->
                        <template x-if="game.starters && game.starters.length > 0">
                            <div>
                                <template x-if="!selectedStarter && isFirstStop">
                                    <div class="bg-bg-surface rounded-2xl border-2 border-action shadow-sm p-5">
                                        <h3 class="text-xs font-black text-action uppercase tracking-widest mb-1">🌟 First, Choose Your Starter!</h3>
                                        <p class="text-xs text-text-tertiary mb-4">Your starter Pokémon will travel with you the whole game. Pick the one that fits your style!</p>
                                        <div class="grid grid-cols-3 gap-3">
                                            <template x-for="starter in game.starters" :key="starter.name">
                                                <button
                                                    @click="selectStarter(starter)"
                                                    class="flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-border hover:border-action hover:bg-action-subtle transition cursor-pointer">
                                                    <img
                                                        :src="spriteUrl(starter.id)"
                                                        :alt="starter.name"
                                                        class="w-16 h-16 object-contain"
                                                        style="image-rendering:pixelated">
                                                    <span class="font-black text-text-primary text-sm capitalize" x-text="starter.name"></span>
                                                    <span x-html="typeBadgeHtml(starter.type)"></span>
                                                    <span class="text-[10px] text-text-tertiary text-center leading-tight" x-text="starter.description"></span>
                                                </button>
                                            </template>
                                        </div>
                                    </div>
                                </template>

                                <template x-if="selectedStarter">
                                    <div class="bg-action-subtle border border-action rounded-2xl p-3 flex items-center gap-3">
                                        <img :src="spriteUrl(selectedStarter.id)" :alt="selectedStarter.name" class="w-10 h-10 object-contain" style="image-rendering:pixelated">
                                        <div class="flex-1 min-w-0">
                                            <div class="text-[10px] font-black text-action uppercase tracking-widest">Your Starter</div>
                                            <div class="font-black text-text-primary text-sm capitalize" x-text="selectedStarter.name"></div>
                                        </div>
                                        <button
                                            x-show="isFirstStop"
                                            @click="clearStarter()"
                                            class="text-[10px] font-bold text-text-tertiary hover:text-action transition px-2 py-1 rounded-lg hover:bg-action-subtle">
                                            Change
                                        </button>
                                    </div>
                                </template>
                            </div>
                        </template>

                        <!-- What to do -->
                        <template x-if="currentStop.steps && currentStop.steps.length > 0">
                            <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5">
                                <h3 class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-4">📋 What To Do</h3>
                                <ol class="space-y-3">
                                    <template x-for="(step, i) in currentStop.steps" :key="i">
                                        <li class="flex gap-3 text-sm text-text-primary leading-relaxed">
                                            <span x-show="!collectionManifest" class="w-6 h-6 rounded-full bg-action-subtle text-action font-black text-xs flex items-center justify-center shrink-0 mt-0.5" x-text="i + 1"></span>
                                            <input x-show="collectionManifest" type="checkbox" :checked="collectionState.completedSteps.includes(currentCollectionStop?.stepIds[i])" @change="toggleCollectionStep(currentCollectionStop?.stepIds[i])" :aria-label="`Mark step ${i + 1} complete: ${step}`" class="mt-1 h-4 w-4 shrink-0 accent-action" />
                                            <span x-text="step"></span>
                                        </li>
                                    </template>
                                </ol>
                            </div>
                        </template>

                        <template x-if="collectionManifest && currentCollectionStop && (currentCollectionStop.items.length || currentCollectionStop.species.length)">
                            <section aria-label="Guide-listed collection checklist" class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5">
                                <h3 class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-2">Guide-listed collection</h3>
                                <p class="text-xs text-text-secondary mb-4">Mark what you actually collected, saw or caught. This checklist is separate from finishing the story stop.</p>
                                <div class="grid gap-5 md:grid-cols-2">
                                    <div x-show="currentCollectionStop.items.length">
                                        <h4 class="font-bold text-sm text-text-primary mb-2">Items &amp; rewards</h4>
                                        <div class="space-y-2">
                                            <template x-for="item in currentCollectionStop.items" :key="item.id">
                                                <label class="flex items-start gap-2 text-sm text-text-secondary"><input type="checkbox" :checked="collectionState.collectedItems.includes(item.id)" @change="toggleCollectedItem(item.id)" :aria-label="`Mark ${item.name} collected`" class="mt-0.5 h-4 w-4 shrink-0 accent-action" /><span x-text="item.name"></span></label>
                                            </template>
                                        </div>
                                    </div>
                                    <div x-show="currentCollectionStop.species.length">
                                        <h4 class="font-bold text-sm text-text-primary mb-2">Pokémon</h4>
                                        <div class="space-y-2">
                                            <template x-for="pokemon in currentCollectionStop.species" :key="pokemon.id">
                                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text-secondary">
                                                    <span class="min-w-20 capitalize" x-text="pokemon.name"></span>
                                                    <label class="flex items-center gap-1"><input type="checkbox" :checked="collectionState.seenSpecies.includes(pokemon.id)" @change="toggleSeenSpecies(pokemon.id)" :aria-label="`Mark ${pokemon.name} seen`" class="h-4 w-4 accent-action" />Seen</label>
                                                    <label class="flex items-center gap-1"><input type="checkbox" :checked="collectionState.caughtSpecies.includes(pokemon.id)" @change="toggleCaughtSpecies(pokemon.id)" :aria-label="`Mark ${pokemon.name} caught`" class="h-4 w-4 accent-action" />Caught</label>
                                                </div>
                                            </template>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </template>

                        <!-- Keep inactive rich content inert; Alpine mounts only the selected stop. -->
                        {entry.locations.map((location) => (
                            <template x-if={`activeStopId === ${JSON.stringify(location.stopId)}`}>
                                <GuideLocationDetails location={location} />
                            </template>
                        ))}

                        {entry.optionalLocations.map((location) => (
                            <template x-if={`activeStopId === ${JSON.stringify(location.stopId)}`}>
                                <GuideOptionalLocation location={location} />
                            </template>
                        ))}

                        <!-- Gym battle -->
                        <template x-if="!currentStop.locationPilot && currentStop.gym">
                            <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5">
                                <h3 class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-4"><GuideSectionIcon name="gym" />Gym Battle</h3>

                                <div class="flex items-center justify-between gap-4 mb-4 flex-wrap">
                                    <div>
                                        <div class="font-black text-text-primary text-lg" x-text="currentStop.gym.leader"></div>
                                        <div class="text-sm text-text-tertiary font-semibold" x-text="`Specialty: ${currentStop.gym.type}`"></div>
                                        <template x-if="currentStop.gym.recommendedLevel">
                                            <div class="text-xs text-action font-bold mt-1" x-text="`Recommended team level: ${currentStop.gym.recommendedLevel}+`"></div>
                                        </template>
                                    </div>
                                    <div class="flex flex-col items-end gap-1">
                                        <template x-if="currentStop.gym.badge">
                                            <span class="text-xs font-black text-action bg-action-subtle border border-action px-3 py-1 rounded-full" x-text="currentStop.gym.badge"></span>
                                        </template>
                                        <template x-if="currentStop.gym.tmReward">
                                            <span class="text-[11px] font-bold text-text-tertiary" x-text="currentStop.gym.tmReward"></span>
                                        </template>
                                    </div>
                                </div>

                                <!-- Team -->
                                <div class="flex flex-wrap gap-3 mb-4">
                                    <template x-for="mon in currentStop.gym.team" :key="mon.name + mon.level">
                                        <div class="flex flex-col items-center gap-1 bg-bg-elevated rounded-xl p-2.5 border border-border-subtle min-w-18">
                                            <img
                                                :src="spriteUrl(mon.id)"
                                                :alt="mon.name"
                                                class="w-14 h-14 object-contain"
                                                style="image-rendering:pixelated"
                                                loading="lazy">
                                            <span class="text-[11px] font-black text-text-primary capitalize" x-text="mon.name"></span>
                                            <span class="text-[10px] text-text-tertiary font-semibold" x-text="`Lv. ${mon.level}`"></span>
                                        </div>
                                    </template>
                                </div>

                                <!-- Strategy -->
                                <div class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 rounded-xl p-3.5 mb-3">
                                    <p class="text-sm text-amber-800 dark:text-amber-200 font-medium leading-relaxed">
                                        <span class="font-black text-amber-700 dark:text-amber-300">Strategy: </span>
                                        <span x-text="currentStop.gym.strategy"></span>
                                    </p>
                                </div>

                                <!-- Starter hint -->
                                <template x-if="selectedStarter && currentStop.gym.starterHints && currentStop.gym.starterHints[selectedStarter.name.toLowerCase()]">
                                    <div class="bg-action-subtle border border-action rounded-xl p-3 mb-3 flex items-center gap-2">
                                        <img :src="spriteUrl(selectedStarter.id)" class="w-6 h-6 object-contain" style="image-rendering:pixelated">
                                        <p class="text-sm text-text-primary font-medium leading-relaxed">
                                            <span class="font-black text-action" x-text="'With your ' + selectedStarter.name + ': '"></span>
                                            <span x-text="currentStop.gym.starterHints[selectedStarter.name.toLowerCase()]"></span>
                                        </p>
                                    </div>
                                </template>

                                <!-- Weaknesses -->
                                <template x-if="currentStop.gym.weaknesses && currentStop.gym.weaknesses.length > 0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="text-[10px] font-black text-text-tertiary uppercase tracking-widest">Weak to:</span>
                                        <template x-for="type in currentStop.gym.weaknesses" :key="type">
                                            <span x-html="typeBadgeHtml(type)"></span>
                                        </template>
                                    </div>
                                </template>
                            </div>
                        </template>

                        <!-- Items -->
                        <template x-if="!currentStop.locationPilot && currentStop.items && currentStop.items.length > 0">
                            <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5">
                                <h3 class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-4">🎒 Items</h3>
                                <div class="space-y-2">
                                    <template x-for="item in currentStop.items" :key="item.name">
                                        <div class="flex items-start gap-3 p-3 bg-bg-elevated rounded-xl border border-border-subtle">
                                            <span class="text-xl shrink-0" x-text="item.icon ?? '📦'"></span>
                                            <div>
                                                <div class="text-sm font-black text-text-primary" x-text="item.name"></div>
                                                <div class="text-xs text-text-tertiary font-medium mt-0.5" x-text="item.location"></div>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </template>

                        <!-- Wild Pokémon -->
                        <template x-if="!currentStop.locationPilot && currentStop.wildPokemon && currentStop.wildPokemon.length > 0">
                            <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5">
                                <h3 class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-3" x-text="currentStop.encounterTitle || 'Pokémon to find along the way'"></h3>
                                <template x-if="currentStop.encounterNote">
                                    <p class="text-sm text-text-secondary mb-4 leading-relaxed" x-text="currentStop.encounterNote"></p>
                                </template>
                                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-3">
                                    <template x-for="entry in currentStop.wildPokemon" :key="entry.name + entry.method">
                                        <button
                                            type="button"
                                            @click="openPokedex(entry.name)"
                                            :aria-label="`View ${entry.name} in Pokédex`"
                                            class="flex flex-col items-center gap-1.5 bg-bg-elevated rounded-xl p-3 border border-border-subtle cursor-pointer hover:border-action hover:bg-action-subtle transition focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2">
                                            <img
                                                :src="spriteUrl(entry.id)"
                                                :alt="entry.name"
                                                class="w-14 h-14 object-contain"
                                                style="image-rendering:pixelated"
                                                loading="lazy">
                                            <span class="text-[11px] font-black text-text-primary capitalize" x-text="entry.name"></span>
                                            <span class="text-[10px] text-text-secondary font-semibold" x-text="entry.levels ? `Lv. ${entry.levels.join(', ')}` : `Lv. ${entry.minLevel}–${entry.maxLevel}`"></span>
                                            <template x-if="entry.location">
                                                <span class="text-[10px] text-action font-bold text-center" x-text="entry.location"></span>
                                            </template>
                                            <template x-if="entry.versionNote">
                                                <span class="text-[10px] text-text-secondary font-semibold text-center" x-text="entry.versionNote"></span>
                                            </template>
                                            <span
                                                class="text-[10px] font-bold px-2 py-0.5 rounded-full capitalize"
                                                :class="{
                                                    'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400': entry.method === 'grass',
                                                    'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-400': entry.method === 'surf',
                                                    'bg-cyan-100 text-cyan-700 dark:bg-cyan-900/40 dark:text-cyan-400': entry.method === 'fishing',
                                                    'bg-stone-100 text-stone-600 dark:bg-stone-900/40 dark:text-stone-400': entry.method === 'cave',
                                                    'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-400': entry.method === 'gift' || entry.method === 'trade',
                                                }"
                                                x-text="entry.method">
                                            </span>
                                            <template x-if="entry.rarity">
                                                <span
                                                    class="text-[9px] font-black uppercase tracking-wide"
                                                    :class="{
                                                        'text-text-tertiary': entry.rarity === 'common',
                                                        'text-amber-500': entry.rarity === 'uncommon',
                                                        'text-action': entry.rarity === 'rare',
                                                    }"
                                                    x-text="entry.rarity">
                                                </span>
                                            </template>
                                            <span class="text-[9px] text-action font-semibold">View in Pokédex</span>
                                        </button>
                                    </template>
                                </div>
                            </div>
                        </template>

                        {entry.fishing.map((section) => (
                            <template x-if={`activeStopId === ${JSON.stringify(section.stopId)}`}>
                                <GuideFishingDetails section={section} />
                            </template>
                        ))}

                        <!-- Tips -->
                        <template x-if="!currentStop.locationPilot && currentStop.tips && currentStop.tips.length > 0">
                            <div class="bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800 rounded-2xl p-5">
                                <h3 class="text-xs font-black text-blue-600 dark:text-blue-400 uppercase tracking-widest mb-3">💡 Tips</h3>
                                <ul class="space-y-2">
                                    <template x-for="(tip, i) in currentStop.tips" :key="i">
                                        <li class="text-sm text-blue-900 dark:text-blue-200 font-medium leading-relaxed flex gap-2">
                                            <span class="shrink-0 text-blue-400 font-black">•</span>
                                            <span x-text="tip"></span>
                                        </li>
                                    </template>
                                </ul>
                            </div>
                        </template>

                        <!-- Navigation buttons -->
                        <div class="flex justify-between items-center">
                            <template x-if="hasPreviousStop()">
                                <button @click="goPrevious()" class="px-5 py-2.5 bg-bg-elevated text-text-secondary rounded-xl hover:bg-bg-raised font-bold text-sm transition flex items-center gap-2">
                                    ← Previous Stop
                                </button>
                            </template>
                            <template x-if="!hasPreviousStop()">
                                <div></div>
                            </template>
                            <template x-if="hasNextStop()">
                                <button @click="goNext()" class="px-5 py-2.5 bg-action text-white rounded-xl hover:bg-action-hover font-bold text-sm transition flex items-center gap-2">
                                    Next Stop →
                                </button>
                            </template>
                            <template x-if="isLastStop()">
                                <div class="px-5 py-2.5 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 rounded-xl font-bold text-sm flex items-center gap-2">
                                    🏆 You've reached the end!
                                </div>
                            </template>
                        </div>

                    </div>
                </template>
            </main>
        </div>
        <p class="mt-6 text-xs text-text-tertiary leading-relaxed">Gym icon: <a class="underline hover:text-action" href="https://commons.wikimedia.org/wiki/File:GymIcon.png">“GymIcon” by Lukehewitt4</a> · <a class="underline hover:text-action" href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Image unmodified.</p>
    </div>
</Layout>
