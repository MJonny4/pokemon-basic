---
import Layout from '../layouts/Layout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import TeamSlots from '../components/team/TeamSlots.astro'
import SetEditorPanel from '../components/team/SetEditorPanel.astro'
import TeamAnalysis from '../components/team/TeamAnalysis.astro'
import BattleSimulator from '../components/team/BattleSimulator.astro'
import TeamPortability from '../components/team/TeamPortability.astro'
const base = import.meta.env.BASE_URL
---

<Layout title="PokeBasic — Team Lab" description="Build Pokémon sets, explore type matchups, export your team, and try experimental CPU battles in PokeBasic Team Lab.">
    <SiteHeader subtitle="Team Lab" activeRoute="/team" />

    <main class="max-w-7xl mx-auto px-4 py-8" x-data="teamLab">

        <!-- ── Header: title + team toolbar ── -->
        <div class="mb-6 flex items-end justify-between gap-4 flex-wrap">
            <div>
                <h1 class="text-2xl font-black text-text-primary mb-1">🧪 Team Lab</h1>
                <p class="text-sm text-text-tertiary font-medium">Click an empty slot to search. Click a filled slot to edit moves, nature, item &amp; EVs.</p>
            </div>
            <div class="flex gap-2" x-show="$store.team.slots.some(s => s && s.pokemonName)" style="display:none">
                <button @click="copyTeam()"
                    :class="teamCopied ? 'bg-green-600 border-green-600 text-white' : 'bg-bg-surface border-border hover:border-action hover:text-action text-text-secondary'"
                    class="flex items-center gap-1.5 px-4 py-1.5 rounded-xl border-2 text-xs font-bold transition active:scale-95">
                    <span x-text="teamCopied ? '✅ Copied!' : '📋 Copy Team'"></span>
                </button>
                <button @click="validateForBattle() && $dispatch('open-battle')"
                    class="flex items-center gap-1.5 px-4 py-1.5 rounded-xl border-2 bg-action border-action hover:bg-action-hover text-white text-xs font-bold transition active:scale-95 shadow-sm">
                    ⚔️ Battle Mode
                </button>
            </div>
        </div>

        <!-- Source-checked Red/Blue opponent, opened only from an explicit guide link. -->
        <section x-show="opponentId || opponentMessage" x-cloak aria-label="Red and Blue opponent matchup" class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5 mb-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <p class="text-xs font-black uppercase tracking-widest text-action">Red / Blue · Gen I type matchup</p>
                    <h2 class="text-xl font-black text-text-primary mt-1" x-text="currentOpponent?.name ?? 'Opponent comparison'"></h2>
                </div>
                <a href={`${base}/games/red-blue/`} class="text-xs font-bold text-action hover:underline">Return to Red / Blue guide</a>
            </div>
            <p x-show="opponentMessage" x-text="opponentMessage" role="status" class="text-sm text-text-secondary mt-3"></p>
            <template x-if="currentOpponent">
                <div class="mt-3">
                    <p class="text-xs text-text-secondary leading-relaxed">This compares your selected damaging Red/Blue moves with the opponent’s original Gen I types. It uses the source-checked guide party and Gen I type chart. It does not calculate damage or check move legality. Modern EVs, IVs, natures, abilities, items and Tera Type are not used.</p>
                    <template x-if="currentOpponent.variants">
                        <div role="group" aria-label="Your original starter for this rival battle" class="flex flex-wrap gap-2 mt-3">
                            <template x-for="option in [[1, 'Bulbasaur'], [4, 'Charmander'], [7, 'Squirtle']]" :key="option[0]">
                                <button type="button" @click="chooseOpponentStarter(option[0])" :aria-pressed="opponentStarterId === option[0]" class="px-3 py-2 rounded-xl border text-xs font-bold focus-visible:outline-2 focus-visible:outline-action" :class="opponentStarterId === option[0] ? 'border-action bg-action-subtle text-action' : 'border-border-subtle text-text-secondary'" x-text="`You chose ${option[1]}`"></button>
                            </template>
                        </div>
                    </template>
                    <p x-show="$store.team.slots.every(s => s === null)" class="mt-4 text-sm text-text-secondary">Add a Pokémon and select a Red/Blue damaging move to compare it with this party.</p>
                    <div class="grid gap-3 mt-4 md:grid-cols-2" aria-live="polite">
                        <template x-for="row in opponentRows" :key="row.opponent.id">
                            <article class="min-w-0 rounded-xl border border-border-subtle bg-bg-elevated p-3">
                                <h3 class="font-black text-sm text-text-primary capitalize" x-text="`${row.opponent.name} · Lv. ${row.opponent.level}`"></h3>
                                <p class="text-xs text-text-tertiary capitalize" x-text="row.types.join(' / ')"></p>
                                <div class="mt-2 space-y-1.5">
                                    <template x-for="choice in row.choices" :key="choice.slotIndex">
                                        <div class="rounded-lg border border-border-subtle bg-bg-surface p-2 text-xs">
                                            <p class="font-bold text-text-primary capitalize" x-text="choice.pokemonName.replace(/-/g, ' ')"></p>
                                            <p x-show="choice.multiplier !== null" class="text-text-secondary"><span x-text="choice.moveName"></span> · <strong x-text="`${choice.multiplier}×`"></strong> by type</p>
                                            <p x-show="choice.reason" x-text="choice.reason" class="text-amber-700 dark:text-amber-300"></p>
                                            <p x-show="choice.ignoredMoves > 0" class="text-text-tertiary" x-text="`${choice.ignoredMoves} selected move${choice.ignoredMoves === 1 ? '' : 's'} excluded: unavailable in Red/Blue or without ordinary damage.`"></p>
                                        </div>
                                    </template>
                                </div>
                            </article>
                        </template>
                    </div>
                </div>
            </template>
        </section>

        <!-- ── Your Team island ── -->
        <TeamSlots />

        <!-- ── Working row: set editor (70) + analysis rail (30) ── -->
        <div class="grid gap-5 lg:grid-cols-[7fr_3fr] items-start mt-5"
            x-show="$store.team.slots.some(s => s !== null)" style="display:none">

            <div class="min-w-0">
                <SetEditorPanel />

                <!-- Placeholder when no slot is being edited -->
                <div x-show="$store.team.activeSlot === null"
                    class="bg-bg-surface rounded-2xl border border-border-subtle border-dashed shadow-sm p-10 text-center" style="display:none">
                    <div class="text-3xl mb-2">✏️</div>
                    <p class="text-sm font-bold text-text-secondary">Click a Pokémon above to edit its set</p>
                    <p class="text-xs text-text-tertiary font-medium mt-1">Nature, ability, held item, EVs/IVs, moves and a damage calculator.</p>
                </div>
            </div>

            <TeamAnalysis />

        </div>

        <TeamPortability />

        <!-- Empty state -->
        <div x-show="$store.team.slots.every(s => s === null)"
            class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-16 text-center mt-5" style="display:none">
            <div class="text-5xl mb-4">🧪</div>
            <h2 class="text-lg font-black text-text-primary mb-2">Your team is empty</h2>
            <p class="text-sm text-text-tertiary max-w-sm mx-auto mb-6">
                Click any slot above to search, or open the Pokédex and use the "Add to Team Lab" button.
            </p>
            <a href={base}
                class="inline-block px-6 py-2.5 bg-action text-white rounded-xl hover:bg-action-hover font-bold text-sm transition shadow-md">
                Open Pokédex →
            </a>
        </div>

        <BattleSimulator />

    </main>
</Layout>
