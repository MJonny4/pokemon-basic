---
import Layout from '../../layouts/Layout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import itemsCatalogJson from '../../lib/data/items-catalog.json'
import {
    EXCLUDED_ITEM_CATEGORIES, itemCardStyle, itemSpriteImg, pocketPill,
    pocketLabel, categoryLabel, formatCost,
} from '../../ui/item-card'
import { genChip } from '../../ui/move-card'

interface CatalogItem { name: string; slug: string; category: string; pocket: string; gen: number | null; cost: number; effect: string }
export interface Props { item: CatalogItem }

// getStaticPaths runs in an isolated scope at build time — it can only see
// imports, so it builds its own list here (same gotcha as games/[game].astro)
export function getStaticPaths() {
    const catalog = itemsCatalogJson as unknown as CatalogItem[]
    return catalog
        .filter((item) => !EXCLUDED_ITEM_CATEGORIES.has(item.category))
        .map((item) => ({ params: { item: item.slug }, props: { item } }))
}

const base = import.meta.env.BASE_URL
const { item } = Astro.props

const infoBlocks = [
    { label: 'Pocket', value: pocketLabel(item.pocket) },
    { label: 'Category', value: categoryLabel(item.category) },
    { label: 'Cost', value: formatCost(item.cost) },
]

const description = `${item.name} — ${categoryLabel(item.category)}. ${item.effect}`.slice(0, 160)
---

<Layout title={`${item.name} — Items | PokeBasic`} description={description} canonicalPath={`/items/${item.slug}`}>
    <SiteHeader subtitle="Item Dex" activeRoute="/items" />

    <main class="max-w-5xl mx-auto px-4 py-6">

        <a href={`${base}/items`} class="inline-flex items-center gap-1 text-xs font-bold text-text-tertiary hover:text-action transition mb-4">
            ← All items
        </a>

        <div x-data="itemDetail" data-item={item.slug} class="grid gap-5 lg:grid-cols-[7fr_3fr] items-start">

            <!-- ══════════ LEFT COLUMN (70%) ══════════ -->
            <div class="space-y-5 min-w-0">

                <!-- HERO — same skin as the listing cards -->
                <div class="rounded-2xl border border-border-subtle shadow-sm p-6" style={itemCardStyle(item.pocket)}>
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex items-center gap-4 min-w-0">
                            <div class="w-16 h-16 rounded-2xl bg-bg-elevated border border-border-subtle flex items-center justify-center text-3xl shrink-0">
                                <Fragment set:html={itemSpriteImg(item, 'w-12 h-12 object-contain', base)} />
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-3xl font-black text-text-primary mb-2">{item.name}</h1>
                                <div class="flex items-center gap-2 flex-wrap">
                                    <Fragment set:html={pocketPill(item.pocket)} />
                                    <span class="text-sm font-bold text-text-tertiary">{categoryLabel(item.category)}</span>
                                </div>
                            </div>
                        </div>
                        {item.gen != null && <Fragment set:html={genChip(item.gen)} />}
                    </div>
                </div>

                <!-- INFO ISLANDS -->
                <div class="grid grid-cols-3 gap-3">
                    {infoBlocks.map((s) => (
                        <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-4 text-center">
                            <div class="text-[10px] font-black text-text-tertiary uppercase tracking-widest mb-1">{s.label}</div>
                            <div class="text-base sm:text-xl font-black text-text-primary">{s.value}</div>
                        </div>
                    ))}
                </div>

                <!-- EFFECT -->
                <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5">
                    <div class="flex items-center gap-2.5 mb-3">
                        <div class="w-8 h-8 rounded-full bg-action-subtle flex items-center justify-center shrink-0 text-action font-black text-sm">ℹ</div>
                        <h2 class="font-black text-text-primary text-sm">Effect</h2>
                    </div>
                    <p class="text-sm text-text-secondary font-medium">{item.effect || 'No effect description available.'}</p>
                    {item.gen === null && (
                        <p class="text-xs text-text-tertiary font-medium mt-3">
                            Introduction generation unknown — this item has no per-game index data in PokéAPI.
                        </p>
                    )}
                </div>

            </div>

            <!-- ══════════ RIGHT COLUMN (30%) — HELD BY ══════════ -->
            <div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5 lg:sticky lg:top-4 h-fit min-w-0">
                <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-3">
                    Held by <span x-show="!loading && !failed && holders.length > 0" x-cloak>(<span x-text="holders.length"></span> Pokémon)</span>
                </p>

                <div x-show="loading" class="flex items-center gap-3 py-4">
                    <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-action"></div>
                    <span class="text-sm text-text-tertiary font-semibold">Loading holders…</span>
                </div>

                <p x-show="failed" x-cloak class="text-sm text-text-tertiary font-semibold py-2">
                    Couldn't load the holder list — check your connection and refresh.
                </p>

                <p x-show="!loading && !failed && holders.length === 0" x-cloak class="text-sm text-text-tertiary font-semibold py-2">
                    No wild Pokémon hold this item.
                </p>

                <div x-show="!loading && holders.length > 0" x-cloak class="flex flex-wrap gap-1.5 max-h-[70vh] overflow-y-auto pr-1">
                    <template x-for="p in holders" :key="p.id">
                        <button @click="openPokemon(p.name)"
                            class="inline-flex items-center gap-1 pl-1 pr-2.5 py-0.5 rounded-full bg-bg-elevated border border-border-subtle hover:border-action hover:bg-action-subtle text-xs font-semibold text-text-secondary hover:text-action transition">
                            <img :src="`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${p.id}.png`"
                                :alt="p.name" loading="lazy" class="w-6 h-6" style="image-rendering:pixelated">
                            <span x-text="capitalize(p.name)"></span>
                        </button>
                    </template>
                </div>
            </div>

        </div>

    </main>
</Layout>
