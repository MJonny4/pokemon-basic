---
import Layout from '../layouts/Layout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { fetchNews, formatNewsDate, type NewsSource } from '../lib/news'
import { SITE_UPDATES, formatUpdateDate } from '../lib/data/site-updates'

const base = import.meta.env.BASE_URL
const news = await fetchNews()

const sourceBadge: Record<NewsSource, string> = {
    'Bulbanews': 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
    'PokémonDB': 'bg-sky-500/10 text-sky-600 dark:text-sky-400',
}

const shortcuts = [
    { href: `${base}/types`, icon: '⚔️', title: 'Type Chart', desc: 'Every matchup, all 18 types' },
    { href: `${base}/stats`, icon: '📊', title: 'Stats', desc: 'Base stat rankings & explorer' },
    { href: `${base}/team`, icon: '🧪', title: 'Team Lab', desc: 'Build & analyze your team' },
    { href: `${base}/games/red-blue`, icon: '🎮', title: 'Game Guides', desc: 'Walkthroughs, Gen I–IV' },
]
---

<Layout>
    <SiteHeader subtitle="Ultra Moon · Gen I–IX" activeRoute="/" maxWidth="screen-2xl" />

    <main class="max-w-screen-2xl mx-auto px-4 py-5 grid gap-5 lg:grid-cols-[1fr_22rem] items-start">

        <!-- ══════════ QUICK ACCESS (right column on lg, top on mobile) ══════════ -->
        <aside class="lg:col-start-2 lg:row-start-1">
            <h2 class="text-sm font-black text-text-primary uppercase tracking-wide mb-3 px-1">Shortcuts</h2>
            <div class="grid grid-cols-2 gap-4">
                {shortcuts.map((s) => (
                    <a href={s.href} class="bg-bg-surface rounded-2xl shadow-sm border border-border-subtle p-4 hover:border-action transition group">
                        <div class="text-2xl mb-2">{s.icon}</div>
                        <h3 class="text-sm font-black text-text-primary group-hover:text-action transition">{s.title}</h3>
                        <p class="text-[11px] text-text-tertiary mt-0.5 font-medium leading-snug">{s.desc}</p>
                    </a>
                ))}
            </div>
        </aside>

        <!-- ══════════ NEWS + SITE UPDATES (left column) ══════════ -->
        <section class="lg:col-start-1 lg:row-start-1 space-y-5">

            <!-- Franchise news -->
            <div>
                <div class="flex items-baseline justify-between mb-3 px-1">
                    <h2 class="text-sm font-black text-text-primary uppercase tracking-wide">Franchise News</h2>
                    <span class="text-[10px] font-bold text-text-tertiary uppercase tracking-wider">Updated daily at build</span>
                </div>

                {news.length > 0 ? (
                    <div x-data={`{ shown: 5, total: ${news.length} }`}>
                        <div class="grid gap-3">
                            {news.map((item, i) => (
                                <a
                                    href={item.link}
                                    target="_blank"
                                    rel="noopener"
                                    x-show={`${i} < shown`}
                                    style={i >= 5 ? 'display:none' : undefined}
                                    class="flex gap-4 bg-bg-surface rounded-2xl shadow-sm border border-border-subtle p-4 hover:border-action transition group"
                                >
                                    <div class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-xl bg-bg-raised shrink-0 grid place-items-center text-3xl overflow-hidden">
                                        <span aria-hidden="true">📰</span>
                                        {item.image && (
                                            <img
                                                src={item.image}
                                                alt=""
                                                loading="lazy"
                                                referrerpolicy="no-referrer"
                                                onerror="this.remove()"
                                                class="absolute inset-0 w-full h-full object-cover"
                                            />
                                        )}
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-start gap-2 mb-1.5">
                                            <span class:list={['text-[10px] font-black uppercase tracking-wide px-2 py-0.5 rounded-md', sourceBadge[item.source]]}>{item.source}</span>
                                            <span class="ml-auto shrink-0 text-[10px] font-bold text-text-tertiary">{formatNewsDate(item.date)}</span>
                                        </div>
                                        <h3 class="text-[13px] font-bold text-text-primary leading-snug group-hover:text-action transition line-clamp-2">{item.title}</h3>
                                        {item.excerpt && (
                                            <p class="text-xs text-text-tertiary mt-1 font-medium leading-relaxed line-clamp-2">{item.excerpt}</p>
                                        )}
                                    </div>
                                </a>
                            ))}
                        </div>
                        {news.length > 5 && (
                            <button
                                type="button"
                                x-show="shown < total"
                                x-on:click="shown += 5"
                                class="w-full mt-3 py-2.5 rounded-2xl bg-bg-surface border border-border-subtle shadow-sm text-xs font-black uppercase tracking-wide text-text-secondary hover:border-action hover:text-action transition"
                            >
                                Load more news
                            </button>
                        )}
                    </div>
                ) : (
                    <div class="bg-bg-surface rounded-2xl shadow-sm border border-border-subtle p-6 text-center">
                        <p class="text-sm font-bold text-text-secondary">News feeds were unreachable at build time.</p>
                        <p class="text-xs text-text-tertiary mt-1 font-medium">Fresh headlines will appear on the next daily rebuild.</p>
                    </div>
                )}
            </div>

            <!-- Site updates -->
            <div>
                <h2 class="text-sm font-black text-text-primary uppercase tracking-wide mb-3 px-1">Site Updates</h2>
                <div class="bg-bg-surface rounded-2xl shadow-sm border border-border-subtle divide-y divide-border-subtle">
                    {SITE_UPDATES.map((u) => (
                        <div class="flex items-baseline gap-3 px-4 py-3">
                            <span class="text-[10px] font-bold text-text-tertiary font-mono shrink-0 w-24">{formatUpdateDate(u.date)}</span>
                            <div>
                                <h3 class="text-[13px] font-bold text-text-primary leading-snug">{u.title}</h3>
                                {u.note && <p class="text-xs text-text-tertiary mt-0.5 font-medium">{u.note}</p>}
                            </div>
                        </div>
                    ))}
                </div>
            </div>

        </section>
    </main>
</Layout>
