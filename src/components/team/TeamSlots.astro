---
// Team slot grid — Alpine scope: x-data="teamLab" (inherited from parent main)
---

<!-- ══════════ TEAM SLOTS ══════════ -->
<div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5">
    <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-4">Your Team</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <template x-for="(slot, i) in $store.team.slots" :key="i">
            <div class="relative">

                <!-- ── Filled slot: colored-border card keyed to first type ── -->
                <div x-show="slot !== null" :id="`slot-card-${i}`"
                    @click="openSetEditor(i)"
                    draggable="true"
                    @dragstart="startDrag(i)"
                    @dragend="dragSource = null"
                    @dragover.prevent
                    @drop.prevent="onDrop(i)"
                    :style="slot ? slotCardStyle(slot) : ''"
                    :class="$store.team.activeSlot === i
                        ? 'border-action ring-2 ring-action/20 shadow-md'
                        : dragSource === i
                            ? 'opacity-50'
                            : 'border-border-subtle hover:border-action hover:shadow-sm'"
                    class="rounded-2xl border p-3 flex flex-col items-center gap-1.5 transition group relative min-h-37 justify-center cursor-grab active:cursor-grabbing">
                    <button @click.stop="removeSlot(i)"
                        class="absolute top-2 right-2 w-6 h-6 flex items-center justify-center rounded-full bg-bg-raised hover:bg-red-500/15 text-text-tertiary hover:text-red-500 text-xs font-bold transition opacity-0 group-hover:opacity-100 z-10">✕</button>
                    <img :src="`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${slot?.pokemonId}.png`"
                        :alt="slot?.pokemonName"
                        class="w-14 h-14 object-contain"
                        style="image-rendering:pixelated"
                        @error="$el.style.visibility='hidden'">
                    <span class="text-xs font-black text-text-primary capitalize text-center leading-tight"
                        x-text="slot?.pokemonName?.replace(/-/g, ' ')"></span>
                    <span class="text-[9px] text-text-tertiary font-semibold capitalize text-center"
                        x-text="slot?.role?.replace(/_/g, ' ')"></span>
                    <div class="flex gap-1 flex-wrap justify-center" x-show="slot?.nature || slot?.item">
                        <span x-show="slot?.nature"
                            class="text-[9px] font-bold px-1.5 py-0.5 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded-full capitalize"
                            x-text="slot?.nature"></span>
                        <span x-show="slot?.item"
                            class="text-[9px] font-bold px-1.5 py-0.5 bg-blue-500/10 text-blue-600 dark:text-blue-400 rounded-full truncate max-w-17"
                            x-text="slot?.item"></span>
                    </div>
                    <div x-show="slot?.moves?.filter(Boolean).length > 0"
                        class="text-[9px] font-bold text-text-tertiary group-hover:text-action transition">
                        <span x-text="slot?.moves?.filter(Boolean).length"></span>/4 moves
                    </div>
                    <div class="absolute bottom-1.5 right-2 text-[10px] text-text-tertiary group-hover:text-action transition">✏️</div>
                </div>

                <!-- ── Empty slot ── -->
                <div x-show="slot === null" :id="`slot-card-${i}`"
                    @dragover.prevent
                    @drop.prevent="onDrop(i)"
                    :class="searchSlot === i ? 'border-action bg-action-subtle/40' : 'border-border-subtle hover:border-action'"
                    class="bg-bg-elevated rounded-2xl border-2 border-dashed p-3 flex flex-col items-center justify-center gap-2 transition min-h-37">
                    <div x-show="searchSlot !== i && addingSlot !== i"
                        @click="openSearch(i)"
                        class="flex flex-col items-center gap-2 cursor-pointer w-full justify-center">
                        <div class="w-10 h-10 rounded-full bg-bg-raised flex items-center justify-center text-text-tertiary text-xl hover:bg-action-subtle hover:text-action transition">+</div>
                        <span class="text-xs text-text-tertiary font-semibold">Slot <span x-text="i + 1"></span></span>
                    </div>
                    <div x-show="addingSlot === i" class="flex flex-col items-center gap-2">
                        <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-action"></div>
                        <span class="text-xs text-text-tertiary font-semibold">Adding…</span>
                    </div>
                    <div x-show="searchSlot === i" class="w-full px-1" @click.stop>
                        <input :id="`slot-input-${i}`"
                            x-model="query"
                            @input="handleInput()"
                            @keydown.escape="closeSearch()"
                            @keydown.enter.prevent="results.length > 0 && selectResult(results[0].name, i)"
                            placeholder="Search…"
                            class="w-full text-xs px-2 py-1.5 border-2 border-action rounded-lg focus:outline-none font-semibold bg-bg-surface text-text-primary placeholder:font-normal placeholder:text-text-tertiary">
                        <button @click="closeSearch()"
                            class="mt-1 text-[10px] text-text-tertiary hover:text-brand transition font-semibold">✕ Cancel</button>
                    </div>
                </div>

                <!-- ── Search dropdown ── -->
                <div x-show="searchSlot === i && results.length > 0"
                    class="absolute left-0 right-0 top-full mt-1 bg-bg-surface border border-border-subtle rounded-xl shadow-xl overflow-hidden z-30"
                    style="display:none">
                    <template x-for="r in results" :key="r.name">
                        <div @click="selectResult(r.name, i)"
                            class="flex items-center gap-2 px-2.5 py-2 hover:bg-action-subtle cursor-pointer transition border-b border-border-subtle last:border-0">
                            <img :src="`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${r.id}.png`"
                                class="w-7 h-7 object-contain shrink-0" style="image-rendering:pixelated"
                                @error="$el.style.visibility='hidden'">
                            <span class="text-xs font-semibold text-text-primary capitalize flex-1"
                                x-text="r.name.replace(/-/g, ' ')"></span>
                            <span class="text-[10px] text-text-tertiary shrink-0"
                                x-text="'#' + String(r.id).padStart(3, '0')"></span>
                        </div>
                    </template>
                </div>

            </div>
        </template>
    </div>
</div>
