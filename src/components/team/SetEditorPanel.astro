---
// Set editor panel — owns x-data="setEditor"
// Shown when $store.team.activeSlot !== null
---

<div x-data="setEditor" x-show="$store.team.activeSlot !== null" id="set-editor-panel"
    class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm"
    style="display:none">

    <!-- ── Panel header ── -->
    <div class="px-5 pt-4 pb-3 border-b border-border-subtle flex items-center gap-3 bg-bg-elevated rounded-t-2xl overflow-hidden">
        <img :src="`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${slot?.pokemonId}.png`"
            class="w-10 h-10 object-contain shrink-0" style="image-rendering:pixelated">
        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <p class="font-black text-sm text-text-primary capitalize"
                    x-text="slot?.pokemonName?.replace(/-/g, ' ')"></p>
                <template x-for="t in (slot?.types ?? [])" :key="t">
                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-white text-[9px] font-black capitalize"
                        :style="`background:${moveColor(t)}`">
                        <img :src="typeIcon(t)" class="w-3 h-3 shrink-0" style="filter:brightness(0) invert(1)">
                        <span x-text="t"></span>
                    </span>
                </template>
            </div>
            <p class="text-[10px] text-text-tertiary font-semibold capitalize"
                x-text="slot?.role?.replace(/_/g, ' ')"></p>
        </div>
        <!-- Level -->
        <div class="flex items-center gap-2 shrink-0">
            <span class="text-xs text-text-tertiary font-bold">Lv.</span>
            <input type="number" min="1" max="100"
                :value="slot?.level ?? 50"
                @change="setLevel(Number($event.target.value))"
                class="w-14 text-center text-sm font-black border-2 border-border rounded-lg py-1 focus:outline-none focus:border-action bg-bg-surface text-text-primary">
        </div>
        <!-- Showdown export -->
        <button @click="copyShowdown()"
            :class="copied ? 'bg-green-500 text-white border-green-500' : 'bg-bg-surface text-text-secondary border-border hover:border-action hover:text-action'"
            class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-lg border-2 text-xs font-bold transition">
            <span x-text="copied ? '✓ Copied!' : '📋 Showdown'"></span>
        </button>
        <!-- Close -->
        <button @click="closeEditor()"
            class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-bg-raised text-text-tertiary hover:text-text-primary font-bold transition shrink-0">✕</button>
    </div>

    <!-- ── Nature + EVs / IVs ── -->
    <div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- LEFT: Nature + Ability + Tera + Item -->
        <div class="space-y-5">

            <!-- NATURE -->
            <div>
                <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-3">Nature</p>
                <div class="flex flex-wrap gap-1.5 mb-2">
                    <template x-for="n in recommendedNatureNames" :key="n">
                        <button @click="setNature(n)"
                            :class="slot?.nature === n ? 'fchip-active' : ''"
                            class="fchip py-1! px-2.5! text-xs!">
                            <span x-text="n"></span>
                            <span x-show="naturePlus(n)"
                                class="text-[10px] opacity-60 ml-0.5"
                                x-text="naturePlus(n) ? ' +' + (STAT_LABELS[naturePlus(n)] ?? naturePlus(n)) + ' −' + (STAT_LABELS[natureMinus(n) ?? ''] ?? natureMinus(n)) : ''"></span>
                        </button>
                    </template>
                </div>
                <details class="group">
                    <summary class="text-[10px] font-black text-text-tertiary uppercase tracking-widest cursor-pointer hover:text-action transition select-none list-none flex items-center gap-1">
                        <span>All natures</span>
                        <span class="group-open:rotate-180 transition-transform duration-200">▾</span>
                    </summary>
                    <div class="flex flex-wrap gap-1 mt-2">
                        <template x-for="n in allNatures" :key="n">
                            <button @click="setNature(n)"
                                :class="slot?.nature === n
                                    ? 'bg-action text-white border-action'
                                    : isRecommendedNature(n)
                                        ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/30 hover:border-emerald-500'
                                        : 'bg-bg-elevated text-text-secondary border-border hover:border-action hover:text-action'"
                                class="px-2 py-0.5 rounded-full text-[10px] font-bold border transition"
                                x-text="n"></button>
                        </template>
                    </div>
                </details>
            </div>

            <!-- ABILITY -->
            <div>
                <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-3">Ability</p>
                <div x-show="slotAbilities.length > 0" class="flex flex-wrap gap-1.5">
                    <template x-for="ab in slotAbilities" :key="ab">
                        <button @click="setAbility(ab)"
                            :class="slot?.ability === ab ? 'fchip-active' : ''"
                            class="fchip py-1! px-2.5! text-xs! capitalize"
                            x-text="ab.replace(/-/g, ' ')"></button>
                    </template>
                </div>
                <p x-show="slotAbilities.length === 0" class="text-xs text-text-tertiary italic">Loading…</p>
            </div>

            <!-- TERA TYPE -->
            <div>
                <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-3">
                    Tera Type <span class="normal-case tracking-normal font-semibold text-text-tertiary">· used in Showdown export only</span>
                </p>
                <div class="flex flex-wrap gap-1">
                    <template x-for="t in allTypes" :key="t">
                        <button @click="setTeraType(t)"
                            :style="slot?.teraType === t
                                ? `background:${typeColor(t)};border-color:${typeColor(t)};color:white`
                                : `border-color:${typeColor(t)}55;color:var(--text-secondary)`"
                            class="px-2 py-0.5 rounded-full text-[10px] font-bold border-2 transition-all capitalize hover:opacity-80"
                            x-text="t"></button>
                    </template>
                </div>
            </div>

            <!-- ITEM -->
            <div>
                <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-3">Held Item</p>
                <div class="grid grid-cols-2 gap-2">
                    <template x-for="item in recommendedItems" :key="item.name">
                        <button @click="setItem(item.name)"
                            :style="slot?.item === item.name
                                ? `background:linear-gradient(${item.border}4d, ${item.border}4d), var(--bg-surface);border-color:${item.border}`
                                : `background:linear-gradient(${item.border}26, ${item.border}26), var(--bg-surface);border-color:${item.border}66`"
                            class="flex items-start gap-2 p-2 rounded-xl border-2 text-left transition hover:scale-[1.02] active:scale-95 relative">
                            <span class="absolute top-1 right-1 text-[9px] leading-none" title="Recommended">⭐</span>
                            <img :src="item.emoji" class="w-6 h-6 object-contain shrink-0 mt-0.5">
                            <div class="min-w-0">
                                <p class="text-[10px] font-black leading-tight text-text-primary" x-text="item.name"></p>
                                <p class="text-[9px] font-medium leading-tight mt-0.5 line-clamp-2 text-text-tertiary" x-text="item.desc"></p>
                            </div>
                        </button>
                    </template>

                    <!-- Custom item picker -->
                    <div class="relative" x-show="!isCustomItemSelected"
                        @click.outside="itemDropdownOpen = false">
                        <div class="border-2 border-dashed border-border rounded-xl p-2 flex flex-col gap-1 bg-bg-elevated hover:border-action transition h-full min-h-18">
                            <div class="flex items-center gap-1.5">
                                <span class="text-text-tertiary text-xs shrink-0">🔍</span>
                                <input x-model="itemQuery"
                                    @input="itemDropdownOpen = itemQuery.length >= 2"
                                    @focus="if (itemQuery.length >= 2) itemDropdownOpen = true"
                                    placeholder="Any item…"
                                    class="flex-1 text-[10px] bg-transparent outline-none placeholder:text-text-tertiary text-text-primary font-semibold min-w-0">
                                <button x-show="itemQuery.length > 0"
                                    @click="itemQuery = ''; itemDropdownOpen = false"
                                    class="text-text-tertiary hover:text-text-primary transition shrink-0 text-xs leading-none">✕</button>
                            </div>
                            <p class="text-[9px] text-text-tertiary font-medium">Search all items</p>
                        </div>
                        <div x-show="itemDropdownOpen && filteredAllItems.length > 0"
                            class="absolute z-20 top-full left-0 right-0 mt-1 bg-bg-surface border border-border-subtle rounded-xl shadow-xl max-h-52 overflow-y-auto">
                            <template x-for="i in filteredAllItems" :key="i.slug">
                                <button @click="selectCustomItem(i.name)"
                                    class="flex items-center gap-2 w-full px-3 py-2 hover:bg-action-subtle text-left transition border-b border-border-subtle last:border-0">
                                    <span class="w-6 h-6 flex items-center justify-center shrink-0" x-html="itemIconHtml(i)"></span>
                                    <div class="min-w-0 flex-1">
                                        <span x-text="i.name" class="text-[11px] font-bold text-text-primary block"></span>
                                        <span x-text="itemDesc(i)" class="text-[9px] text-text-tertiary line-clamp-1 block"></span>
                                    </div>
                                </button>
                            </template>
                        </div>
                    </div>

                    <button x-show="isCustomItemSelected"
                        @click="setItem(slot?.item)"
                        class="flex items-start gap-2 p-2 rounded-xl border-2 border-action bg-action-subtle text-left transition hover:scale-[1.02] active:scale-95 relative">
                        <span class="absolute top-1 right-1 text-[9px] leading-none text-action" title="Custom pick">✏️</span>
                        <span class="w-6 h-6 mt-0.5 flex items-center justify-center shrink-0"
                            x-html="customItemData ? itemIconHtml(customItemData) : '🎒'"></span>
                        <div class="min-w-0">
                            <p class="text-[10px] font-black leading-tight text-text-primary" x-text="slot?.item"></p>
                            <p class="text-[9px] font-medium leading-tight mt-0.5 line-clamp-2 text-text-tertiary"
                                x-text="customItemData ? itemDesc(customItemData) : ''"></p>
                        </div>
                    </button>
                </div>
            </div>

        </div>

        <!-- RIGHT: EVs + IVs -->
        <div>
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs font-black text-text-tertiary uppercase tracking-widest">EVs</p>
                <div class="flex items-center gap-3">
                    <span class="text-xs font-black"
                        :class="totalEvs >= 508 ? 'text-red-500' : totalEvs >= 400 ? 'text-amber-500' : 'text-text-secondary'">
                        <span x-text="totalEvs"></span><span class="text-text-tertiary font-semibold"> / 508</span>
                    </span>
                    <button @click="resetEvs()"
                        class="text-[10px] font-black text-text-tertiary hover:text-brand uppercase tracking-widest transition">↺ Reset</button>
                </div>
            </div>
            <div class="h-1.5 bg-bg-raised rounded-full mb-4 overflow-hidden">
                <div class="h-full rounded-full transition-all duration-300"
                    :class="totalEvs >= 508 ? 'bg-red-400' : 'bg-action'"
                    :style="`width:${Math.min(100, Math.round(totalEvs / 508 * 100))}%`"></div>
            </div>

            <div class="space-y-3">
                <template x-for="key in statKeys" :key="key">
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-black w-7 shrink-0 text-right"
                            :style="`color:${STAT_COLORS[key]}`"
                            x-text="STAT_LABELS[key]"></span>
                        <span class="text-[10px] text-text-tertiary font-semibold w-7 shrink-0 text-right"
                            x-text="slot?.stats[key] ?? 0"></span>
                        <input type="range" min="0" max="252" step="4"
                            :value="slot?.evs[key] ?? 0"
                            @input="setEv(key, Number($event.target.value))"
                            :style="`accent-color:${STAT_COLORS[key]}`"
                            class="flex-1 h-1.5 cursor-pointer">
                        <input type="number" min="0" max="252" step="4"
                            :value="slot?.evs[key] ?? 0"
                            @change="setEv(key, Number($event.target.value))"
                            @blur="$event.target.value = slot?.evs[key] ?? 0"
                            :class="(slot?.evs[key] ?? 0) >= 252 ? 'text-action border-red-500/40' : (slot?.evs[key] ?? 0) > 0 ? 'text-text-secondary border-border' : 'text-text-tertiary border-border'"
                            class="text-[10px] font-bold w-9 shrink-0 text-right bg-transparent border rounded px-0.5 focus:outline-none focus:border-action focus:bg-bg-surface focus:text-text-primary appearance-none [&::-webkit-inner-spin-button]:hidden [&::-webkit-outer-spin-button]:hidden [-moz-appearance:textfield]">
                        <div class="flex items-center gap-0.5 w-12 shrink-0 justify-end">
                            <span x-show="natureEffect(key) !== 0"
                                class="text-[9px] font-black"
                                :class="natureEffect(key) === 1 ? 'text-blue-400' : 'text-rose-400'"
                                x-text="natureEffect(key) === 1 ? '▲' : '▼'"></span>
                            <span class="text-xs font-black"
                                :style="`color:${STAT_COLORS[key]}`"
                                x-text="statValue(key)"></span>
                        </div>
                    </div>
                </template>
            </div>

            <details class="group mt-4">
                <summary class="flex items-center justify-between cursor-pointer select-none list-none">
                    <span class="text-[10px] font-black text-text-tertiary uppercase tracking-widest hover:text-action transition flex items-center gap-1">
                        IVs
                        <span class="group-open:rotate-180 transition-transform duration-200">▾</span>
                    </span>
                    <button @click.prevent="resetIvs()"
                        class="text-[10px] font-black text-text-tertiary hover:text-brand uppercase tracking-widest transition">↺ Reset 31</button>
                </summary>
                <div class="space-y-2.5 mt-3">
                    <template x-for="key in statKeys" :key="key">
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] font-black w-7 shrink-0 text-right"
                                :style="`color:${STAT_COLORS[key]}`"
                                x-text="STAT_LABELS[key]"></span>
                            <input type="range" min="0" max="31" step="1"
                                :value="slot?.ivs?.[key] ?? 31"
                                @input="setIv(key, Number($event.target.value))"
                                :style="`accent-color:${STAT_COLORS[key]}`"
                                class="flex-1 h-1.5 cursor-pointer">
                            <input type="number" min="0" max="31" step="1"
                                :value="slot?.ivs?.[key] ?? 31"
                                @change="setIv(key, Number($event.target.value))"
                                @blur="$event.target.value = slot?.ivs?.[key] ?? 31"
                                :class="(slot?.ivs?.[key] ?? 31) < 31 ? 'text-amber-500 border-amber-500/40' : 'text-text-tertiary border-transparent'"
                                class="text-xs font-bold w-8 shrink-0 text-right bg-transparent border rounded px-0.5 focus:outline-none focus:border-action focus:bg-bg-surface focus:text-text-primary appearance-none [&::-webkit-inner-spin-button]:hidden [&::-webkit-outer-spin-button]:hidden [-moz-appearance:textfield]">
                            <span class="text-[10px] font-bold w-8 shrink-0 text-right text-text-tertiary"
                                x-text="statValue(key)"></span>
                        </div>
                    </template>
                </div>
            </details>
        </div>

    </div>

    <!-- ══ DAMAGE CALCULATOR ══ -->
    <div class="px-5 pb-4 border-t border-border-subtle pt-4">
        <button @click="calcOpen = !calcOpen"
            class="flex items-center gap-2 w-full text-left group">
            <span class="text-xs font-black text-text-tertiary uppercase tracking-widest group-hover:text-action transition">⚡ Damage Calculator</span>
            <span class="text-text-tertiary group-hover:text-action transition text-xs" x-text="calcOpen ? '▴' : '▾'"></span>
        </button>

        <div x-show="calcOpen" x-cloak class="mt-3 space-y-3">

            <div class="relative" @click.outside="calcDefenderAcOpen = false">
                <div class="flex items-center gap-2 border-2 border-border rounded-xl px-3 py-2 focus-within:border-action transition bg-bg-surface">
                    <template x-if="calcDefenderPokemon">
                        <img :src="`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${calcDefenderPokemon?.id}.png`"
                            class="w-8 h-8 object-contain shrink-0" style="image-rendering:pixelated">
                    </template>
                    <span class="text-text-tertiary text-xs shrink-0">vs.</span>
                    <input x-model="calcDefenderQuery"
                        @input="calcDefenderAcOpen = calcDefenderQuery.length >= 2"
                        @focus="if (calcDefenderQuery.length >= 2) calcDefenderAcOpen = true"
                        placeholder="Search defender Pokémon…"
                        class="flex-1 text-xs bg-transparent outline-none placeholder:text-text-tertiary text-text-primary font-semibold min-w-0">
                    <template x-if="calcDefenderPokemon">
                        <div class="flex gap-1 shrink-0">
                            <template x-for="t in calcDefenderPokemon.types" :key="t.type.name">
                                <span :style="`background:${typeColor(t.type.name)};color:white`"
                                    class="px-1.5 py-0.5 rounded text-[9px] font-bold tracking-wide capitalize"
                                    x-text="t.type.name"></span>
                            </template>
                        </div>
                    </template>
                    <button x-show="calcDefenderQuery.length > 0"
                        @click="calcDefenderQuery=''; calcDefenderPokemon=null; calcResults=[]"
                        class="text-text-tertiary hover:text-text-primary text-xs shrink-0">✕</button>
                </div>
                <div x-show="calcDefenderAcOpen && calcDefenderSuggestionsList.length > 0"
                    class="absolute z-30 top-full left-0 right-0 mt-1 bg-bg-surface border border-border-subtle rounded-xl shadow-xl overflow-hidden">
                    <template x-for="p in calcDefenderSuggestionsList" :key="p.name">
                        <button @click="selectCalcDefender(p)"
                            class="flex items-center gap-2 w-full px-3 py-2 hover:bg-action-subtle text-left border-b border-border-subtle last:border-0">
                            <img :src="`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${p.id}.png`"
                                class="w-6 h-6 object-contain shrink-0" style="image-rendering:pixelated">
                            <span class="text-xs font-semibold text-text-primary capitalize" x-text="p.name.replace(/-/g,' ')"></span>
                        </button>
                    </template>
                </div>
            </div>

            <div class="flex flex-wrap gap-1.5 items-center">
                <template x-for="[val, label] in [['sun','☀️'],['rain','🌧'],['sand','🏔'],['snow','❄️']]" :key="val">
                    <button @click="calcWeather = calcWeather === val ? null : val"
                        :class="calcWeather === val ? 'bg-action text-white border-action' : 'bg-bg-surface text-text-secondary border-border hover:border-action'"
                        class="px-2 py-1 rounded-lg border text-xs font-bold transition"
                        x-text="label + ' ' + val.charAt(0).toUpperCase() + val.slice(1)"></button>
                </template>
                <button @click="calcReflect = !calcReflect"
                    :class="calcReflect ? 'bg-blue-500 text-white border-blue-500' : 'bg-bg-surface text-text-secondary border-border hover:border-blue-400'"
                    class="px-2 py-1 rounded-lg border text-xs font-bold transition">🛡 Reflect</button>
                <button @click="calcLightScreen = !calcLightScreen"
                    :class="calcLightScreen ? 'bg-yellow-400 text-yellow-950 border-yellow-400' : 'bg-bg-surface text-text-secondary border-border hover:border-yellow-400'"
                    class="px-2 py-1 rounded-lg border text-xs font-bold transition">✨ LightScr</button>
                <button @click="calcCrit = !calcCrit"
                    :class="calcCrit ? 'bg-red-500 text-white border-red-500' : 'bg-bg-surface text-text-secondary border-border hover:border-red-400'"
                    class="px-2 py-1 rounded-lg border text-xs font-bold transition">💥 Crit</button>
            </div>

            <div class="flex flex-wrap gap-2 text-[10px] text-text-secondary items-center">
                <span class="font-black text-text-tertiary uppercase tracking-widest">Defender:</span>
                <label class="flex items-center gap-1">Lv
                    <input type="number" min="1" max="100" x-model.number="calcDefenderLevel"
                        class="w-12 text-center border border-border rounded px-1 py-0.5 text-xs font-bold focus:outline-none focus:border-action bg-bg-surface text-text-primary">
                </label>
                <label class="flex items-center gap-1">EV Def
                    <input type="number" min="0" max="252" step="4" x-model.number="calcDefenderEvDef"
                        class="w-14 text-center border border-border rounded px-1 py-0.5 text-xs font-bold focus:outline-none focus:border-action bg-bg-surface text-text-primary">
                </label>
                <label class="flex items-center gap-1">EV SpD
                    <input type="number" min="0" max="252" step="4" x-model.number="calcDefenderEvSpd"
                        class="w-14 text-center border border-border rounded px-1 py-0.5 text-xs font-bold focus:outline-none focus:border-action bg-bg-surface text-text-primary">
                </label>
                <label class="flex items-center gap-1">IV
                    <input type="number" min="0" max="31" x-model.number="calcDefenderIv"
                        class="w-11 text-center border border-border rounded px-1 py-0.5 text-xs font-bold focus:outline-none focus:border-action bg-bg-surface text-text-primary">
                </label>
            </div>

            <div x-show="calcResults.length > 0" class="rounded-xl border border-border-subtle overflow-hidden">
                <table class="w-full text-[10px]">
                    <thead>
                        <tr class="bg-bg-elevated border-b border-border-subtle">
                            <th class="text-left px-2 py-1.5 font-black text-text-tertiary uppercase tracking-widest">Move</th>
                            <th class="px-2 py-1.5 font-black text-text-tertiary uppercase tracking-widest">Eff.</th>
                            <th class="px-2 py-1.5 font-black text-text-tertiary uppercase tracking-widest">Damage</th>
                            <th class="px-2 py-1.5 font-black text-text-tertiary uppercase tracking-widest hidden sm:table-cell">KO?</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="(row, i) in calcResults" :key="i">
                            <tr class="border-b border-border-subtle last:border-0 hover:bg-bg-elevated">
                                <td class="px-2 py-2">
                                    <div class="flex items-center gap-1.5">
                                        <span x-show="row.move?.type?.name"
                                            :style="`background:${moveColor(row.move?.type?.name ?? '')};color:white`"
                                            class="px-1 py-0.5 rounded text-[8px] font-bold tracking-wide capitalize shrink-0"
                                            x-text="row.move?.type?.name ?? ''"></span>
                                        <span class="font-bold text-text-primary capitalize"
                                            x-text="(row.moveName ?? '—').replace(/-/g,' ')"></span>
                                        <span x-show="row.move?.damage_class?.name === 'status'"
                                            class="text-[9px] text-text-tertiary font-semibold">status</span>
                                    </div>
                                </td>
                                <td class="px-2 py-2 text-center font-black"
                                    :class="!row.result ? 'text-text-tertiary' : row.result.effectiveness >= 2 ? 'text-green-500' : row.result.effectiveness <= 0.5 ? 'text-red-400' : row.result.effectiveness === 0 ? 'text-text-tertiary' : 'text-text-secondary'"
                                    x-text="row.result ? effectivenessLabel(row.result.effectiveness) : '—'"></td>
                                <td class="px-2 py-2 text-center">
                                    <template x-if="row.result && row.result.effectiveness > 0">
                                        <span class="font-black text-text-primary">
                                            <span x-text="row.result.min"></span>–<span x-text="row.result.max"></span>
                                            <span class="font-semibold text-text-tertiary ml-1">(<span x-text="row.result.minPct"></span>–<span x-text="row.result.maxPct"></span>%)</span>
                                        </span>
                                    </template>
                                    <span x-show="!row.result || row.result.effectiveness === 0" class="text-text-tertiary font-semibold">—</span>
                                </td>
                                <td class="px-2 py-2 text-center hidden sm:table-cell">
                                    <span x-show="row.result && row.result.effectiveness > 0"
                                        class="font-black text-[9px]"
                                        :class="row.result?.koChance?.includes('guaranteed OHKO') ? 'text-green-500' : row.result?.koChance?.includes('OHKO') ? 'text-amber-500' : row.result?.koChance?.includes('2HKO') ? 'text-blue-400' : 'text-text-tertiary'"
                                        x-text="row.result?.koChance ?? ''"></span>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>

            <p x-show="calcOpen && !calcDefenderPokemon" class="text-[10px] text-text-tertiary font-semibold text-center py-2">
                Search a defender to see damage calculations.
            </p>

        </div>
    </div>

    <!-- ══ MOVES SECTION ══ -->
    <div class="px-5 pb-5 border-t border-border-subtle pt-4">
        <div class="flex items-center gap-2 mb-3">
            <p class="text-xs font-black text-text-tertiary uppercase tracking-widest">Moves</p>
            <div x-show="movesLoading" class="flex items-center gap-1">
                <div class="animate-spin rounded-full h-3 w-3 border-b-2 border-action"></div>
                <span class="text-[10px] text-text-tertiary">Loading learnset…</span>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-2">
            <template x-for="mi in [0, 1, 2, 3]" :key="mi">
                <div class="relative" @keydown.escape="openMoveSlot === mi && (openMoveSlot = null)" @click.outside="openMoveSlot === mi && (openMoveSlot = null)">
                    <button @click="toggleMoveSearch(mi)"
                        :class="openMoveSlot === mi
                            ? 'border-action bg-action-subtle'
                            : slot?.moves[mi]
                                ? 'border-border-subtle hover:border-action bg-bg-surface'
                                : 'border-dashed border-border-subtle hover:border-action bg-bg-elevated'"
                        class="w-full flex items-center gap-2 px-3 py-2 rounded-xl border-2 text-left transition min-h-10">
                        <template x-if="slot?.moves[mi]">
                            <div class="flex items-center gap-2 min-w-0 flex-1">
                                <span class="inline-flex items-center gap-1 text-[9px] font-black px-1.5 py-0.5 rounded text-white shrink-0 capitalize"
                                    :style="`background:${moveColor(availableMoves.find(m => m.name === slot?.moves[mi])?.type?.name ?? 'normal')}`">
                                    <img :src="typeIcon(availableMoves.find(m => m.name === slot?.moves[mi])?.type?.name ?? 'normal')" class="w-3 h-3 shrink-0" style="filter:brightness(0) invert(1)">
                                    <span x-text="availableMoves.find(m => m.name === slot?.moves[mi])?.type?.name ?? '?'"></span>
                                </span>
                                <span class="text-xs font-bold text-text-primary capitalize truncate"
                                    x-text="(slot?.moves[mi] ?? '').replace(/-/g, ' ')"></span>
                                <span x-show="isStab(slot?.moves[mi])"
                                    class="text-[8px] font-black px-1 py-0.5 rounded bg-yellow-400 text-yellow-900 shrink-0 leading-none ml-auto">STAB</span>
                            </div>
                        </template>
                        <template x-if="!slot?.moves[mi]">
                            <span class="text-xs text-text-tertiary font-semibold">
                                — Move <span x-text="mi + 1"></span> —
                            </span>
                        </template>
                    </button>

                    <div x-show="openMoveSlot === mi"
                        class="absolute left-0 right-0 top-full mt-1 bg-bg-surface border border-border-subtle rounded-xl shadow-xl z-40 overflow-hidden"
                        style="display:none">
                        <div class="p-2 border-b border-border-subtle">
                            <input :id="`move-input-${mi}`"
                                x-model="moveQuery"
                                placeholder="Search move…"
                                class="w-full text-xs px-2 py-1.5 border-2 border-action rounded-lg focus:outline-none font-semibold bg-bg-surface text-text-primary placeholder:font-normal placeholder:text-text-tertiary">
                        </div>
                        <div class="max-h-52 overflow-y-auto">
                            <template x-if="filteredMoves.length === 0 && !movesLoading">
                                <p class="text-xs text-text-tertiary text-center py-4">No moves found</p>
                            </template>
                            <template x-for="m in filteredMoves" :key="m.name">
                                <div @click="selectMove(mi, m.name)"
                                    class="flex items-center gap-2 px-3 py-2 hover:bg-action-subtle cursor-pointer transition border-b border-border-subtle last:border-0">
                                    <span class="inline-flex items-center gap-1 text-[9px] font-black px-1.5 py-0.5 rounded text-white shrink-0 capitalize"
                                        :style="`background:${moveColor(m.type?.name ?? 'normal')}`">
                                        <img :src="typeIcon(m.type?.name ?? 'normal')" class="w-3 h-3 shrink-0" style="filter:brightness(0) invert(1)">
                                        <span x-text="m.type?.name ?? '?'"></span>
                                    </span>
                                    <span class="text-[11px] shrink-0" x-text="moveCategoryIcon(m.damage_class?.name ?? '')"></span>
                                    <span class="text-xs font-semibold text-text-primary capitalize flex-1 truncate"
                                        x-text="m.name.replace(/-/g, ' ')"></span>
                                    <span class="text-[10px] text-text-tertiary shrink-0 font-semibold"
                                        x-text="m.power ? m.power : '—'"></span>
                                </div>
                            </template>
                        </div>
                        <div x-show="slot?.moves[mi]"
                            @click="clearMove(mi); openMoveSlot = null"
                            class="flex items-center gap-2 px-3 py-2.5 hover:bg-red-50 dark:hover:bg-red-900/20 cursor-pointer transition border-t border-border-subtle text-red-400 hover:text-red-500"
                            style="display:none">
                            <span class="text-[10px] font-black">✕</span>
                            <span class="text-xs font-semibold">Clear move</span>
                        </div>
                    </div>
                </div>
            </template>
        </div>
    </div>

</div>
