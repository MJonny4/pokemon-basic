---
// Team analysis rail — one merged island, sticky beside the set editor.
// Alpine scope: x-data="teamLab" (inherited)
---

<!-- ══════════ ANALYSIS RAIL ══════════ -->
<div class="bg-bg-surface rounded-2xl border border-border-subtle shadow-sm p-5 lg:sticky lg:top-4 h-fit min-w-0 space-y-5">

    <p class="text-xs text-text-tertiary leading-relaxed">Modern type matchups and the Gen 3+ set stat formula are used here. This is not a Red/Blue opponent calculator. Move availability for a game is not checked. The synergy score is a heuristic.</p>

    <!-- Synergy -->
    <div>
        <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-3">Heuristic Synergy</p>
        <div class="flex items-end gap-2">
            <span class="text-4xl font-black"
                :class="($store.team.coverage?.synergyScore ?? 0) >= 70 ? 'text-green-500' : ($store.team.coverage?.synergyScore ?? 0) >= 40 ? 'text-amber-500' : 'text-red-500'"
                x-text="$store.team.coverage?.synergyScore ?? 0"></span>
            <span class="text-text-tertiary text-sm font-semibold mb-1">/ 100</span>
        </div>
        <div class="h-2 bg-bg-raised rounded-full mt-2 mb-3">
            <div class="h-full rounded-full transition-all duration-500"
                :class="($store.team.coverage?.synergyScore ?? 0) >= 70 ? 'bg-green-400' : ($store.team.coverage?.synergyScore ?? 0) >= 40 ? 'bg-amber-400' : 'bg-red-400'"
                :style="`width:${$store.team.coverage?.synergyScore ?? 0}%`"></div>
        </div>
        <div class="space-y-1">
            <template x-for="line in ($store.team.coverage?.synergyBreakdown ?? [])" :key="line">
                <p class="text-[10px] font-semibold leading-snug"
                    :class="line.startsWith('+') ? 'text-green-500' : line.startsWith('-') ? 'text-red-400' : 'text-text-tertiary'"
                    x-text="line"></p>
            </template>
        </div>
    </div>

    <hr class="border-border-subtle">

    <!-- Offensive coverage -->
    <div>
        <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-2">Selected Move Coverage</p>
        <div class="flex items-end gap-2">
            <span class="text-3xl font-black text-action"
                x-text="($store.team.coverage?.coverageScore ?? 0) + '%'"></span>
        </div>
        <p class="text-xs text-text-tertiary mt-1">
            <span x-text="$store.team.coverage?.offensiveCoverage?.length ?? 0"></span> of 18 types hit super effectively by <span x-text="$store.team.coverage?.damagingMoveCount ?? 0"></span> selected damaging <span x-text="($store.team.coverage?.damagingMoveCount ?? 0) === 1 ? 'move' : 'moves'"></span>
        </p>
        <p x-show="($store.team.coverage?.unresolvedMoves?.length ?? 0) > 0" class="text-xs text-amber-600 dark:text-amber-400 mt-1">Some saved moves are not in the local catalog and are excluded.</p>
    </div>

    <hr class="border-border-subtle">

    <!-- Common weaknesses -->
    <div>
        <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-2">Common Weaknesses</p>
        <template x-if="($store.team.coverage?.commonWeaknesses?.length ?? 0) === 0">
            <p class="text-sm text-green-500 font-bold">No shared weaknesses!</p>
        </template>
        <div class="flex flex-wrap gap-1.5" x-show="($store.team.coverage?.commonWeaknesses?.length ?? 0) > 0">
            <template x-for="type in ($store.team.coverage?.commonWeaknesses ?? [])" :key="type">
                <span class="inline-flex items-center gap-1 text-[10px] font-black px-2 py-0.5 rounded-full text-white capitalize border-2 border-red-500"
                    :style="`background:${typeColor(type)}`">
                    <img :src="typeIcon(type)" class="w-3 h-3 shrink-0" style="filter:brightness(0) invert(1)">
                    <span x-text="type"></span>
                </span>
            </template>
        </div>
    </div>

    <hr class="border-border-subtle">

    <!-- Immunities -->
    <div>
        <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-2">Team Immunities</p>
        <template x-if="($store.team.coverage?.immunities?.length ?? 0) === 0">
            <p class="text-sm text-text-tertiary font-bold italic">None</p>
        </template>
        <div class="flex flex-wrap gap-1.5" x-show="($store.team.coverage?.immunities?.length ?? 0) > 0">
            <template x-for="type in ($store.team.coverage?.immunities ?? [])" :key="type">
                <span class="inline-flex items-center gap-1 text-[10px] font-black px-2 py-0.5 rounded-full text-white capitalize border-2 border-emerald-400"
                    :style="`background:${typeColor(type)}`">
                    <img :src="typeIcon(type)" class="w-3 h-3 shrink-0" style="filter:brightness(0) invert(1)">
                    <span x-text="type"></span>
                </span>
            </template>
        </div>
    </div>

    <hr class="border-border-subtle">

    <!-- Calculated Speed -->
    <div>
        <p class="text-xs font-black text-text-tertiary uppercase tracking-widest mb-1">Calculated Speed</p>
        <p class="text-xs text-text-tertiary mb-3">Uses each saved set's level, nature, EVs and IVs. Compare at the same level for a fair speed order.</p>
        <div class="space-y-1">
            <template x-for="row in ($store.team.coverage?.speedRows ?? [])" :key="row.slotIndex">
                <p class="flex justify-between gap-2 text-xs text-text-secondary font-semibold">
                    <span class="capitalize" x-text="row.pokemonName.replace(/-/g, ' ') + ' · Lv ' + row.level"></span>
                    <span x-text="row.speed ?? '—'"></span>
                </p>
            </template>
        </div>
    </div>

</div>
