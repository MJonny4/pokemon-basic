---
// Battle simulator full-screen modal + team toast
// Intentionally uses slate-900 dark canvas regardless of light/dark theme
---

<div x-data="battleSim"
    @open-battle.window="openBattle()"
    x-show="open"
    x-cloak
    class="fixed inset-0 z-60 flex flex-col bg-slate-900 text-white overflow-hidden"
    style="display:none">

    <!-- Mode selection overlay -->
    <div x-show="battlePhase === 'mode-select'" x-cloak
        class="absolute inset-0 flex flex-col items-center justify-center bg-slate-900 z-20 p-8">
        <div class="text-5xl mb-5">⚔️</div>
        <h2 class="text-2xl font-black mb-2">Battle Mode</h2>
        <p class="text-slate-400 text-sm mb-8">Choose your opponent's team</p>
        <div x-show="validationErrors.length > 0" class="mb-6 w-full max-w-sm bg-red-900/60 border border-red-500 rounded-xl p-4">
            <p class="text-red-300 font-black text-xs uppercase tracking-widest mb-2">Fix these before battling:</p>
            <template x-for="(err, i) in validationErrors" :key="i">
                <p class="text-red-200 text-xs font-semibold" x-text="'• ' + err"></p>
            </template>
            <button @click="validationErrors = []" class="mt-3 text-[10px] text-red-400 hover:text-red-200 font-bold uppercase tracking-wide transition">Dismiss</button>
        </div>
        <div class="flex flex-col sm:flex-row gap-4">
            <button @click="startBattle()"
                class="flex flex-col items-center gap-2 px-8 py-5 bg-slate-800 border-2 border-slate-600 hover:border-action rounded-2xl transition active:scale-95">
                <span class="text-3xl">🎲</span>
                <span class="font-black text-base">Random Team</span>
                <span class="text-slate-400 text-xs text-center">CPU builds a team<br>from the standard pool</span>
            </button>
            <button @click="battlePhase = 'enemy-select'"
                class="flex flex-col items-center gap-2 px-8 py-5 bg-slate-800 border-2 border-slate-600 hover:border-action rounded-2xl transition active:scale-95">
                <span class="text-3xl">🧩</span>
                <span class="font-black text-base">Pick Enemy Team</span>
                <span class="text-slate-400 text-xs text-center">Choose up to 6 Pokémon<br>for the CPU to use</span>
            </button>
        </div>
        <button @click="closeBattle()" class="mt-8 text-slate-500 hover:text-slate-300 text-sm font-bold transition">Cancel</button>
    </div>

    <!-- Custom enemy picker overlay -->
    <div x-show="battlePhase === 'enemy-select'" x-cloak
        class="absolute inset-0 flex flex-col bg-slate-900 z-20 overflow-y-auto p-6">
        <div class="flex items-center gap-3 mb-6">
            <button @click="battlePhase = 'mode-select'" class="text-slate-400 hover:text-white transition font-bold text-sm">← Back</button>
            <h2 class="text-lg font-black flex-1">Pick Enemy Team</h2>
            <button @click="closeBattle()" class="text-slate-400 hover:text-white transition font-bold text-sm">✕</button>
        </div>
        <p class="text-slate-400 text-xs mb-5">Search and select up to 6 Pokémon. CPU moves are auto-assigned. Empty slots are skipped.</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
            <template x-for="i in [0,1,2,3,4,5]" :key="i">
                <div class="bg-slate-800 rounded-xl p-3 flex flex-col gap-2 relative">
                    <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest" x-text="'Slot ' + (i+1)"></p>
                    <div x-show="!customEnemyNames[i]" class="relative">
                        <input type="text"
                            :value="customEnemyQueries[i]"
                            @input="customEnemyQueries[i] = $event.target.value; onCustomEnemySearch(i)"
                            @keydown.escape="customEnemyAcOpen[i] = false"
                            @blur="setTimeout(() => { customEnemyAcOpen[i] = false }, 150)"
                            placeholder="🔍 Search…"
                            class="w-full px-2 py-1.5 text-xs bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-500 font-semibold focus:outline-none focus:border-action">
                        <div x-show="customEnemyAcOpen[i]" class="absolute top-full left-0 right-0 mt-1 bg-slate-700 border border-slate-600 rounded-xl overflow-hidden z-30 shadow-xl">
                            <template x-for="r in customEnemyAcResults[i]" :key="r.id">
                                <button
                                    class="w-full text-left px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-action hover:text-white flex items-center gap-2 transition capitalize"
                                    @mousedown.prevent="selectCustomEnemy(i, r.name)">
                                    <img :src="`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${r.id}.png`"
                                        :alt="r.name" class="w-7 h-7 object-contain shrink-0" style="image-rendering:pixelated" @error="$el.style.visibility='hidden'">
                                    <span class="text-slate-500 font-mono text-[10px]" x-text="'#'+String(r.id).padStart(3,'0')"></span>
                                    <span x-text="r.name"></span>
                                </button>
                            </template>
                        </div>
                    </div>
                    <div x-show="customEnemyNames[i]" class="flex items-center gap-2">
                        <img :src="customEnemyNames[i] ? `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${allPokemonList.find(p => p.name === customEnemyNames[i])?.id ?? 0}.png` : ''"
                            class="w-10 h-10 object-contain" style="image-rendering:pixelated" @error="$el.style.visibility='hidden'">
                        <div class="flex-1 min-w-0">
                            <p class="text-xs font-black text-white capitalize" x-text="customEnemyNames[i]"></p>
                            <button @click="clearCustomEnemy(i)" class="text-[10px] text-slate-500 hover:text-rose-400 font-semibold transition">Remove</button>
                        </div>
                    </div>
                </div>
            </template>
        </div>
        <div class="flex items-center justify-between">
            <span class="text-slate-400 text-xs" x-text="`${customEnemyFilled} / 6 selected`"></span>
            <button
                :disabled="customEnemyFilled === 0"
                :class="customEnemyFilled === 0 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-action-hover active:scale-95'"
                @click="customEnemyFilled > 0 && startBattle(customEnemyNames.filter(n => n))"
                class="px-6 py-2.5 bg-action rounded-xl font-black text-sm transition">
                ⚔️ Start Battle
            </button>
        </div>
    </div>

    <!-- Loading overlay -->
    <div x-show="loading" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-900 z-10">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-action mb-4"></div>
        <p class="text-slate-400 font-semibold">Building CPU team…</p>
    </div>

    <!-- Winner overlay -->
    <div x-show="state && state.phase === 'battle-end'" x-cloak
        class="absolute inset-0 flex flex-col items-center justify-center bg-slate-900/90 z-10">
        <div class="text-6xl mb-4" x-text="state?.winner === 'player' ? '🏆' : '💀'"></div>
        <p class="text-2xl font-black mb-2" x-text="state?.winner === 'player' ? 'You Won!' : 'You Lost!'"></p>
        <p class="text-slate-400 text-sm mb-6" x-text="'Turn ' + (state?.turn ?? 0)"></p>
        <div class="flex gap-3">
            <button @click="playAgain()" class="px-6 py-2.5 bg-action hover:bg-action-hover rounded-xl font-bold text-sm transition">⚔️ Play Again</button>
            <button @click="closeBattle()" class="px-6 py-2.5 bg-slate-700 hover:bg-slate-600 rounded-xl font-bold text-sm transition">✕ Close</button>
        </div>
    </div>

    <!-- Header bar -->
    <div class="flex items-center justify-between px-4 py-2 bg-slate-800 border-b border-slate-700 shrink-0">
        <span class="font-black text-sm">⚔️ Battle Mode</span>
        <div class="flex items-center gap-2">
            <span x-show="weatherIcon()" x-text="weatherIcon()" class="text-base"></span>
            <span class="text-slate-400 text-xs" x-text="state ? 'Turn ' + state.turn : ''"></span>
        </div>
        <button @click="closeBattle()" class="text-slate-400 hover:text-white transition text-sm font-bold px-2">✕</button>
    </div>

    <!-- Battle arena + log wrapper -->
    <div class="flex-1 flex flex-col sm:flex-row overflow-hidden min-h-0">

    <div class="flex-1 flex flex-col overflow-hidden min-h-0">

        <!-- CPU side -->
        <div class="flex-1 flex flex-col items-center justify-end pb-2 px-4 relative bg-linear-to-b from-slate-800 to-slate-900 min-h-0">
            <div class="absolute top-2 left-4 flex gap-1">
                <template x-for="(p, i) in (state?.cpuTeam ?? [])" :key="i">
                    <div class="relative group">
                        <img :src="spriteUrl(p.pokemonId)" @error="$el.style.visibility='hidden'"
                            :class="p.fainted ? 'opacity-30 grayscale' : state?.cpuActive === i ? 'ring-2 ring-action rounded-full' : ''"
                            class="w-8 h-8 object-contain" style="image-rendering:pixelated">
                        <div class="absolute z-100 top-full left-0 mt-1 hidden group-hover:block pointer-events-none">
                            <div class="bg-slate-800 border border-slate-600 rounded-lg p-2 text-[9px] font-bold whitespace-nowrap shadow-xl">
                                <div class="text-action mb-1 capitalize" x-text="p.name"></div>
                                <div class="space-y-0.5">
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">HP</span><span class="text-white" x-text="p.slot?.evs?.hp ?? 0"></span></div>
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">Atk</span><span class="text-white" x-text="p.slot?.evs?.attack ?? 0"></span></div>
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">Def</span><span class="text-white" x-text="p.slot?.evs?.defense ?? 0"></span></div>
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">SpA</span><span class="text-white" x-text="p.slot?.evs?.['special-attack'] ?? 0"></span></div>
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">SpD</span><span class="text-white" x-text="p.slot?.evs?.['special-defense'] ?? 0"></span></div>
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">Spe</span><span class="text-white" x-text="p.slot?.evs?.speed ?? 0"></span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>

            <template x-if="cpuActive">
                <div class="w-full max-w-xs text-right mb-2">
                    <div class="flex items-center justify-end gap-2 mb-1 flex-wrap">
                        <div class="flex gap-1">
                            <template x-for="t in (cpuActive?.types ?? [])" :key="t">
                                <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-white text-[9px] font-black capitalize"
                                    :style="`background:${moveTypeColor({ type: { name: t } })}`">
                                    <img :src="typeIcon(t)" class="w-2.5 h-2.5 shrink-0" style="filter:brightness(0) invert(1)">
                                    <span x-text="t"></span>
                                </span>
                            </template>
                        </div>
                        <span x-show="cpuActive?.status" class="text-xs" x-text="statusLabel(cpuActive?.status ?? null)"></span>
                        <span class="font-black text-sm" x-text="cpuActive?.name ?? ''"></span>
                        <span class="text-slate-400 text-xs" x-text="'Lv.' + (cpuActive?.slot?.level ?? 50)"></span>
                    </div>
                    <div class="h-2 bg-slate-700 rounded-full overflow-hidden w-full">
                        <div id="cpu-hp-bar" class="h-full rounded-full transition-none"
                            :style="`width:${hpPct(cpuActive)}%;background:${hpColor(hpPct(cpuActive))}`"></div>
                    </div>
                    <p class="text-[10px] text-slate-400 mt-0.5" x-text="cpuActive?.currentHp + ' / ' + cpuActive?.maxHp"></p>
                    <div class="flex flex-wrap gap-1 justify-end mt-1.5">
                        <span x-show="cpuActive?.slot?.nature" class="px-1.5 py-0.5 bg-slate-700 rounded text-[9px] font-bold text-slate-300 capitalize" x-text="cpuActive?.slot?.nature ?? ''"></span>
                        <span x-show="cpuActive?.slot?.ability" class="px-1.5 py-0.5 bg-action/20 rounded text-[9px] font-bold text-action capitalize" x-text="(cpuActive?.slot?.ability ?? '').replace(/-/g, ' ')"></span>
                        <span x-show="cpuActive?.slot?.item" class="px-1.5 py-0.5 bg-amber-900/60 rounded text-[9px] font-bold text-amber-300" x-text="cpuActive?.slot?.item ?? ''"></span>
                    </div>
                    <div class="grid grid-cols-2 gap-1 mt-2">
                        <template x-for="(m, mi) in cpuActiveMoves" :key="mi">
                            <div class="flex items-center gap-1.5 px-2 py-1 rounded-lg bg-slate-800/60 border border-slate-700/50 text-left min-h-8">
                                <template x-if="m">
                                    <span class="inline-flex items-center gap-0.5 text-[8px] font-black px-1 py-0.5 rounded text-white shrink-0 capitalize"
                                        :style="`background:${moveTypeColor(m)}`">
                                        <img :src="moveTypeIcon(m)" class="w-2.5 h-2.5 shrink-0" style="filter:brightness(0) invert(1)">
                                    </span>
                                </template>
                                <span class="text-[10px] font-semibold capitalize flex-1 truncate text-slate-300"
                                    x-text="m ? m.name.replace(/-/g,' ') : '—'"></span>
                                <span class="text-[9px] text-slate-500 shrink-0" x-text="m?.power ?? '—'"></span>
                            </div>
                        </template>
                    </div>
                </div>
            </template>

            <div class="relative group inline-block">
                <img id="cpu-sprite" :src="cpuActive ? spriteUrl(cpuActive.pokemonId) : ''"
                    @error="$el.style.visibility='hidden'" @load="$el.style.visibility=''"
                    class="w-24 h-24 object-contain" style="image-rendering:pixelated; transform-origin: center bottom;">
                <div class="absolute z-50 bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block pointer-events-none">
                    <div class="bg-slate-800 border border-slate-600 rounded-lg p-2 text-[9px] font-bold whitespace-nowrap shadow-xl">
                        <div class="text-action mb-1 capitalize" x-text="cpuActive?.name ?? ''"></div>
                        <div class="space-y-0.5">
                            <div class="flex justify-between gap-3"><span class="text-slate-400">HP</span><span class="text-white" x-text="cpuActive?.slot?.evs?.hp ?? 0"></span></div>
                            <div class="flex justify-between gap-3"><span class="text-slate-400">Atk</span><span class="text-white" x-text="cpuActive?.slot?.evs?.attack ?? 0"></span></div>
                            <div class="flex justify-between gap-3"><span class="text-slate-400">Def</span><span class="text-white" x-text="cpuActive?.slot?.evs?.defense ?? 0"></span></div>
                            <div class="flex justify-between gap-3"><span class="text-slate-400">SpA</span><span class="text-white" x-text="cpuActive?.slot?.evs?.['special-attack'] ?? 0"></span></div>
                            <div class="flex justify-between gap-3"><span class="text-slate-400">SpD</span><span class="text-white" x-text="cpuActive?.slot?.evs?.['special-defense'] ?? 0"></span></div>
                            <div class="flex justify-between gap-3"><span class="text-slate-400">Spe</span><span class="text-white" x-text="cpuActive?.slot?.evs?.speed ?? 0"></span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Player side -->
        <div class="flex-1 flex flex-col items-center justify-start pt-2 px-4 relative bg-linear-to-t from-slate-800 to-slate-900 min-h-0">
            <!-- Player shows the BACK sprite like the games; Gen 9 ids lack back sprites → fall back to front (guard prevents an error loop) -->
            <img id="player-sprite" :src="playerActive ? spriteBackUrl(playerActive.pokemonId) : ''"
                @error="if ($el.src.includes('/back/')) { $el.src = spriteUrl(playerActive?.pokemonId ?? 0) } else { $el.style.visibility='hidden' }"
                @load="$el.style.visibility=''"
                class="w-24 h-24 object-contain" style="image-rendering:pixelated; transform-origin: center top;">
            <template x-if="playerActive">
                <div class="w-full max-w-xs mb-2">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <span class="font-black text-sm" x-text="playerActive?.name ?? ''"></span>
                        <span class="text-slate-400 text-xs" x-text="'Lv.' + (playerActive?.slot?.level ?? 50)"></span>
                        <span x-show="playerActive?.status" class="text-xs" x-text="statusLabel(playerActive?.status ?? null)"></span>
                        <div class="flex gap-1">
                            <template x-for="t in (playerActive?.types ?? [])" :key="t">
                                <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-white text-[9px] font-black capitalize"
                                    :style="`background:${moveTypeColor({ type: { name: t } })}`">
                                    <img :src="typeIcon(t)" class="w-2.5 h-2.5 shrink-0" style="filter:brightness(0) invert(1)">
                                    <span x-text="t"></span>
                                </span>
                            </template>
                        </div>
                    </div>
                    <div class="h-2 bg-slate-700 rounded-full overflow-hidden w-full">
                        <div id="player-hp-bar" class="h-full rounded-full transition-none"
                            :style="`width:${hpPct(playerActive)}%;background:${hpColor(hpPct(playerActive))}`"></div>
                    </div>
                    <p class="text-[10px] text-slate-400 mt-0.5" x-text="playerActive?.currentHp + ' / ' + playerActive?.maxHp"></p>
                </div>
            </template>
            <div class="absolute bottom-2 left-4 flex gap-1">
                <template x-for="(p, i) in (state?.playerTeam ?? [])" :key="i">
                    <div class="relative group">
                        <img :src="spriteUrl(p.pokemonId)" @error="$el.style.visibility='hidden'"
                            :class="p.fainted ? 'opacity-30 grayscale' : state?.playerActive === i ? 'ring-2 ring-action rounded-full' : ''"
                            class="w-8 h-8 object-contain" style="image-rendering:pixelated">
                        <div class="absolute z-100 bottom-full left-0 mb-1 hidden group-hover:block pointer-events-none">
                            <div class="bg-slate-800 border border-slate-600 rounded-lg p-2 text-[9px] font-bold whitespace-nowrap shadow-xl">
                                <div class="text-emerald-300 mb-1 capitalize" x-text="p.name"></div>
                                <div class="space-y-0.5">
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">HP</span><span class="text-white" x-text="p.slot?.evs?.hp ?? 0"></span></div>
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">Atk</span><span class="text-white" x-text="p.slot?.evs?.attack ?? 0"></span></div>
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">Def</span><span class="text-white" x-text="p.slot?.evs?.defense ?? 0"></span></div>
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">SpA</span><span class="text-white" x-text="p.slot?.evs?.['special-attack'] ?? 0"></span></div>
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">SpD</span><span class="text-white" x-text="p.slot?.evs?.['special-defense'] ?? 0"></span></div>
                                    <div class="flex justify-between gap-3"><span class="text-slate-400">Spe</span><span class="text-white" x-text="p.slot?.evs?.speed ?? 0"></span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <div id="battle-log"
        class="w-full sm:w-72 h-full shrink-0 bg-slate-950 border-t sm:border-t-0 sm:border-l border-slate-800 overflow-y-auto px-3 py-2 text-[11px] space-y-0.5 sm:h-auto">
        <template x-for="(line, i) in allLogLines()" :key="i">
            <p :class="logLineClass(line)" class="leading-snug" x-text="line"></p>
        </template>
    </div>

    </div>

    <!-- Switch panel -->
    <div x-show="state && (state.phase === 'switching' || showSwitch)"
        class="absolute inset-0 bg-slate-900/95 flex flex-col items-center justify-center z-10 p-4 overflow-y-auto">
        <template x-if="state?.phase === 'switching'">
            <div class="mb-4 w-full max-w-sm">
                <p class="font-black text-red-400 text-sm text-center mb-2">Your Pokémon fainted!</p>
                <div class="bg-slate-800 rounded-xl px-4 py-3 space-y-0.5 text-[11px]">
                    <template x-for="(line, i) in lastTurnLog" :key="i">
                        <p :class="logLineClass(line)" class="leading-snug" x-text="line"></p>
                    </template>
                </div>
                <p class="text-slate-400 text-xs text-center mt-2 font-semibold">Choose a replacement:</p>
            </div>
        </template>
        <p x-show="state?.phase !== 'switching'" class="font-black text-sm mb-3">Switch Pokémon</p>
        <div class="grid grid-cols-3 gap-2 max-w-sm w-full">
            <template x-for="(p, i) in (state?.playerTeam ?? [])" :key="i">
                <button @click="selectSwitch(i)"
                    :disabled="p.fainted || i === state?.playerActive || animating"
                    :class="p.fainted || i === state?.playerActive || animating ? 'opacity-30 cursor-not-allowed' : 'hover:border-action hover:bg-action/10'"
                    class="flex flex-col items-center p-2 rounded-xl border border-slate-700 transition">
                    <img :src="spriteUrl(p.pokemonId)" class="w-10 h-10 object-contain" style="image-rendering:pixelated" @error="$el.style.visibility='hidden'">
                    <span class="text-[10px] font-bold capitalize mt-1" x-text="p.name"></span>
                    <div class="flex gap-0.5 mt-0.5">
                        <template x-for="t in (p.types ?? [])" :key="t">
                            <span class="px-1 py-0.5 rounded text-white text-[8px] font-black capitalize"
                                :style="`background:${moveTypeColor({ type: { name: t } })}`"
                                x-text="t"></span>
                        </template>
                    </div>
                    <span class="text-[9px] text-slate-400 mt-0.5" x-text="p.currentHp + '/' + p.maxHp"></span>
                </button>
            </template>
        </div>
        <button x-show="state?.phase !== 'switching'" @click="showSwitch = false"
            class="mt-4 px-5 py-2 rounded-xl border border-slate-600 hover:border-red-400 text-slate-400 hover:text-red-300 text-xs font-bold transition">
            ✕ Cancel
        </button>
    </div>

    <!-- Action bar -->
    <div class="shrink-0 bg-slate-800 border-t border-slate-700 p-3">
        <div x-show="state && state.phase === 'selecting'" class="grid grid-cols-2 gap-2">
            <template x-for="(m, mi) in playerActiveMoves" :key="mi">
                <button @click="selectMove(mi)"
                    :disabled="animating"
                    :class="animating && selectedMoveIndex === mi
                        ? 'border-action bg-action/20 scale-95 cursor-not-allowed'
                        : animating
                            ? 'opacity-50 cursor-not-allowed'
                            : m ? 'hover:border-action hover:bg-slate-700' : 'opacity-40 cursor-not-allowed'"
                    class="flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-700 bg-slate-900 transition text-left min-h-12 active:scale-95">
                    <template x-if="m">
                        <span class="inline-flex items-center gap-1 text-[9px] font-black px-1.5 py-0.5 rounded text-white shrink-0 capitalize"
                            :style="`background:${moveTypeColor(m)}`">
                            <img :src="moveTypeIcon(m)" class="w-3 h-3 shrink-0" style="filter:brightness(0) invert(1)">
                            <span x-text="m?.type?.name ?? '?'"></span>
                        </span>
                    </template>
                    <span class="text-xs font-bold capitalize flex-1 truncate"
                        x-text="m ? m.name.replace(/-/g,' ') : ('— Move ' + (mi+1) + ' —')"></span>
                    <div class="flex flex-col items-end gap-0.5 shrink-0">
                        <span class="text-[10px] text-slate-400" x-text="movePower(m)"></span>
                        <span class="text-[9px]" x-text="m?.damage_class?.name === 'physical' ? '⚔️' : m?.damage_class?.name === 'special' ? '🔮' : ''"></span>
                    </div>
                </button>
            </template>
        </div>
        <div class="flex justify-between items-center mt-2">
            <button x-show="state && state.phase === 'selecting'"
                @click="if (!animating) showSwitch = true"
                :disabled="animating"
                class="px-3 py-1.5 rounded-lg border border-slate-600 hover:border-action text-xs font-bold text-slate-300 hover:text-white transition disabled:opacity-40 disabled:cursor-not-allowed">
                🔄 Switch
            </button>
            <span x-show="state && state.phase !== 'selecting'" class="text-[10px] text-slate-500"></span>
            <button @click="forfeit()"
                class="px-3 py-1.5 rounded-lg border border-slate-600 hover:border-red-500 text-xs font-bold text-slate-500 hover:text-red-400 transition">
                🏳 Forfeit
            </button>
        </div>
    </div>
</div>

<!-- Toast notification (bound to teamLab x-data, scoped inside main) -->
<div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none"
    x-show="toast.show"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-2"
    style="display:none">
    <div class="bg-bg-raised text-text-primary text-sm font-semibold px-5 py-3 rounded-2xl shadow-xl"
        x-text="toast.message"></div>
</div>
