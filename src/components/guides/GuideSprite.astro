---
interface Props {
    src: string
    size?: 'item' | 'pokemon'
}
const { src, size = 'pokemon' } = Astro.props
---

<!-- Names remain visible beside every decorative image, even without the CDN. -->
<span class:list={['inline-grid place-items-center shrink-0', size === 'pokemon' ? 'w-20 h-20' : 'w-10 h-10']}>
    <img src={src} alt="" width={size === 'pokemon' ? 80 : 40} height={size === 'pokemon' ? 80 : 40} loading="lazy" decoding="async" class="w-full h-full object-contain" style="image-rendering:pixelated" onerror="this.style.display = 'none'; this.nextElementSibling.style.display = 'grid'" />
    <span aria-hidden="true" class="place-items-center w-full h-full text-text-secondary" style="display:none">
        <svg viewBox="0 0 32 32" class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2"><circle cx="16" cy="16" r="12" /><path d="M4 16h8m8 0h8" /><circle cx="16" cy="16" r="4" /></svg>
    </span>
</span>
