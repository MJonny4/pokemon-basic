---
import type { GuideLocation } from '../../lib/data/guides/location-schema'
import { guideEncounterCards, guideItemVisual, guidePokemonVisual } from '../../ui/guide-location'
import GuidePokemonCard from './GuidePokemonCard.astro'
import GuideSprite from './GuideSprite.astro'
import GuideSectionIcon from './GuideSectionIcon.astro'
import GuideStarterBattle from './GuideStarterBattle.astro'
import GuideLocationWarnings from './GuideLocationWarnings.astro'

interface Props { location: GuideLocation; showWarnings?: boolean }
const { location, showWarnings = true } = Astro.props
const base = import.meta.env.BASE_URL
const card = 'bg-bg-surface rounded-2xl border border-border-subtle p-5 shadow-sm'
const summary = 'cursor-pointer font-black text-sm text-text-primary focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-4'
const locator = location.locator
const leaders = location.trainers.filter((trainer) => trainer.role !== 'trainer')
const otherTrainers = location.trainers.filter((trainer) => trainer.role === 'trainer')
const encounterAreas = location.areas?.filter((area) => location.encounters.some((table) => table.areaId === area.id)) ?? []
const areaName = (areaId?: string) => location.areas?.find((area) => area.id === areaId)?.name
const itemKinds = { visible: 'Visible pickup', hidden: 'Hidden · inspect the square', reward: 'Battle reward', choice: 'Choose one fossil only', gift: 'NPC gift', exchange: 'Exchange · later return' }
const cell = 8
const inset = 32
const px = (x: number) => inset + (x + 0.5) * cell
const py = (y: number) => inset + (y + 0.5) * cell
---

<section x-show={`activeStopId === ${JSON.stringify(location.stopId)}`} x-cloak aria-label={`${location.title} location details`} class="space-y-4" data-location-id={location.id}>
    {showWarnings && <GuideLocationWarnings warnings={location.warnings} />}

    {location.areas && <details class={card}>
        <summary class={summary}>At a glance · places along this stop</summary>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {location.areas.map((area) => <li class="rounded-xl border border-border-subtle bg-bg-elevated p-3">
                <h3 class="font-black text-sm text-text-primary">{area.name}</h3>
                <p class="text-sm text-text-secondary mt-1">{area.description}</p>
            </li>)}
        </ul>
    </details>}

    {location.starterBattles?.map((battle) => <GuideStarterBattle battle={battle} locationId={location.id} stopId={location.stopId} areaName={areaName(battle.areaId)} />)}

    {location.pokemonOffers?.map((offer) => <section class={card} aria-label="Optional Pokémon purchase">
        <h3 class="font-black text-sm text-text-primary mb-3">Optional Pokémon purchase · {areaName(offer.areaId)}</h3>
        <div class="grid sm:grid-cols-[160px_1fr] gap-4 items-center">
            <GuidePokemonCard name={offer.name} dexId={offer.dexId} levelLabel={`Lv. ${offer.level}`} />
            <div><p class="font-black text-action mb-2">₽{offer.price.toLocaleString('en-US')} · one-time purchase</p><p class="text-sm text-text-secondary">{offer.details}</p></div>
        </div>
    </section>)}

    {leaders.map((leader) => (
        <section aria-label={leader.name} class={card}>
            <div class="flex items-start justify-between gap-3 flex-wrap mb-4">
                <div>
                    <p class="text-xs font-black text-text-secondary uppercase tracking-widest mb-1"><GuideSectionIcon name={leader.role === 'leader' ? 'gym' : 'battle'} />{leader.role === 'leader' ? 'Gym battle' : 'Story battle'}</p>
                    <h3 class="text-xl font-black text-text-primary">{leader.name} {leader.role === 'leader' && <span class="text-sm text-text-secondary font-semibold">· Gym Leader</span>}</h3>
                </div>
                <span class="rounded-full px-3 py-1.5 text-xs font-bold bg-action-subtle text-action">Highest opponent: Lv. {Math.max(...leader.party.map((member) => member.level))}</span>
            </div>
            <div class:list={['grid grid-cols-2 gap-3 sm:gap-4', leader.party.length >= 3 && 'sm:grid-cols-3']}>
                {leader.party.map((member) => <GuidePokemonCard name={member.name} dexId={member.dexId} levelLabel={`Lv. ${member.level}`} moves={member.moves} />)}
            </div>
            <p class="mt-3 text-xs text-text-secondary">Choose your attacks for the opponent’s types, not just your Pokémon’s type. Battle preparation is below.</p>
            <a href={`${base}/team/?opponent=${encodeURIComponent(`${location.stopId}:${leader.id}`)}`} class="inline-block mt-3 text-xs font-bold text-action hover:underline">Compare your Team Lab moves with {leader.name}’s Gen I types →</a>
        </section>
    ))}

    {location.pokemonTrades?.map((trade) => <details class={card} data-guide-trade={trade.id}>
        <summary class={summary}>Optional Pokémon trade · {areaName(trade.areaId)}</summary>
        <p class="text-sm text-text-secondary mt-3 mb-4">{trade.details}</p>
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
            <GuidePokemonCard name={trade.give.name} dexId={trade.give.dexId} levelLabel="You give" />
            <GuidePokemonCard name={trade.receive.name} dexId={trade.receive.dexId} levelLabel={`You receive · ${trade.receive.nickname}`} />
        </div>
    </details>)}

    {location.items.length > 0 && <details open class={card}>
        <summary class={summary}><GuideSectionIcon name="items" />Items &amp; rewards ({location.items.length}{location.items.some((item) => item.kind === 'choice') ? ' entries · fossil alternatives included' : ''})</summary>
        <ol class="mt-4 grid gap-3 sm:grid-cols-2">
            {location.items.map((item, index) => {
                const visual = guideItemVisual(item)
                return <li id={`${location.id}-${item.id}`} class:list={['rounded-xl border border-border-subtle bg-bg-elevated p-3 scroll-mt-24 min-w-0', location.items.length % 2 === 1 && index === location.items.length - 1 && 'sm:col-span-2']}>
                    <div class="flex items-center gap-3 mb-3">
                        <span class="w-12 h-12 rounded-xl bg-bg-surface border border-border-subtle inline-grid place-items-center shrink-0 text-action">
                            {visual.spriteUrl ? <GuideSprite src={visual.spriteUrl} size="item" /> : visual.symbol === 'money'
                                ? <span aria-hidden="true" class="text-2xl font-black">₽</span>
                                : visual.symbol === 'badge'
                                    ? <svg aria-hidden="true" viewBox="0 0 32 32" class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 3 10 6v13l-10 7-10-7V9Z" /><path d="m16 9 5 3v7l-5 4-5-4v-7Z" /></svg>
                                    : <svg aria-hidden="true" viewBox="0 0 32 32" class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="9" width="18" height="19" rx="4" /><path d="M11 9V7a5 5 0 0 1 10 0v2M7 17h18M13 17v4h6v-4" /></svg>}
                        </span>
                        <div class="min-w-0">
                            <h4 class="font-black text-sm text-text-primary">{locator && <span class="text-action">{index + 1}. </span>}{visual.symbol === 'money' ? 'Prize money' : item.name} <span class="text-text-secondary font-semibold">{visual.symbol === 'money' ? `₽${item.quantity.toLocaleString('en-US')}` : `×${item.quantity}`}</span></h4>
                            <span class:list={['inline-block text-[10px] font-black rounded-full px-2 py-0.5 mt-1', item.kind === 'hidden' ? 'bg-violet-100 text-violet-800 dark:bg-violet-950/50 dark:text-violet-200' : item.kind === 'reward' || item.kind === 'choice' ? 'bg-amber-100 text-amber-800 dark:bg-amber-950/50 dark:text-amber-200' : 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-200']}>
                                {itemKinds[item.kind]}
                            </span>
                        </div>
                    </div>
                    {item.areaId && <p class="text-xs font-black text-action mb-1">{areaName(item.areaId)}</p>}
                    <p class="text-sm text-text-secondary">{item.location}</p>
                    <p class="text-xs text-text-secondary mt-2 pt-2 border-t border-border-subtle">{item.requirements}</p>
                </li>
            })}
        </ol>
        <p class="mt-3 text-xs text-text-tertiary">Reference list only; individual item collection is not tracked yet.</p>
    </details>}

    {locator && (
        <details class={card}>
            <summary class={summary}>Item locator — coordinate diagram</summary>
            <p class="mt-3 text-sm text-text-secondary">{locator.description}</p>
            <figure class="mt-4">
                <svg viewBox={`0 0 ${locator.width * cell + inset * 2} ${locator.height * cell + inset * 2}`} role="img" aria-labelledby={`${location.id}-locator-title ${location.id}-locator-description`} class="w-full max-w-sm mx-auto text-action">
                    <title id={`${location.id}-locator-title`}>{location.title}: item positions and gates</title>
                    <desc id={`${location.id}-locator-description`}>North is at the top. Numbered circles are visible pickups; dashed squares are hidden pickups. Numbers match the item list. No walls, terrain or walkable paths are shown.</desc>
                    <rect x={inset} y={inset} width={locator.width * cell} height={locator.height * cell} fill="var(--bg-elevated)" stroke="var(--border)" />
                    {Array.from({ length: Math.floor(locator.width / 5) + 1 }, (_, i) => i * 5).map((x) => (
                        <>
                            <line x1={px(x)} y1={inset} x2={px(x)} y2={inset + locator.height * cell} stroke="var(--border-subtle)" />
                            <text x={px(x)} y={inset - 9} text-anchor="middle" font-size="9" fill="var(--text-secondary)">{x}</text>
                        </>
                    ))}
                    {Array.from({ length: Math.floor(locator.height / 5) + 1 }, (_, i) => i * 5).map((y) => (
                        <>
                            <line x1={inset} y1={py(y)} x2={inset + locator.width * cell} y2={py(y)} stroke="var(--border-subtle)" />
                            <text x={inset - 10} y={py(y) + 3} text-anchor="middle" font-size="9" fill="var(--text-secondary)">{y}</text>
                        </>
                    ))}
                    {locator.gates.map((gate) => (
                        <g><title>{gate.label}</title><rect x={px(gate.position.x) - 4} y={py(gate.position.y) - 4} width="8" height="8" fill="var(--text-secondary)" /></g>
                    ))}
                    {location.items.filter((item) => item.position).map((item) => {
                        const index = location.items.indexOf(item)
                        const point = item.position!
                        return <g>
                            <title>{index + 1}. {item.kind} {item.name}, x {point.x}, y {point.y}</title>
                            {item.kind === 'hidden'
                                ? <rect x={px(point.x) - 8} y={py(point.y) - 8} width="16" height="16" rx="3" fill="var(--bg-surface)" stroke="currentColor" stroke-width="2" stroke-dasharray="3 2" />
                                : <circle cx={px(point.x)} cy={py(point.y)} r="8" fill="var(--bg-surface)" stroke="currentColor" stroke-width="2" />}
                            <text x={px(point.x)} y={py(point.y) + 3} text-anchor="middle" font-size="10" font-weight="bold" fill="currentColor">{index + 1}</text>
                        </g>
                    })}
                </svg>
                <figcaption class="text-xs text-text-secondary mt-2">Circles: visible items. Dashed squares: hidden items. Solid blocks: gates. Coordinates increase east → and south ↓.</figcaption>
                <ul class="text-xs text-text-secondary mt-2 list-disc pl-5">{locator.gates.map((gate) => <li>{gate.label}</li>)}</ul>
            </figure>
        </details>
    )}

    <details open={location.encounters.length > 0} class={card}>
        <summary class={summary}><GuideSectionIcon name="wild" />{location.encountersHeading ?? (location.encounters.length > 0 ? 'Wild Pokémon — Red / Blue differences' : 'Wild Pokémon — none inside this location')}</summary>
        <p class="mt-3 text-sm text-text-secondary">{location.encounters.length > 0 ? 'Chances are per generated encounter, not per step or catch. Choose your version below.' : location.encountersNote}</p>
        {location.encounters.length > 0 && <div class="mt-4" x-data={JSON.stringify({ encounterVersion: 'red', encounterArea: encounterAreas[0]?.id ?? '' })}>
            {encounterAreas.length > 1 && <div class="mb-4">
                <label for={`${location.id}-encounter-area`} class="block text-xs font-black text-text-secondary mb-2">Where are you exploring?</label>
                <select id={`${location.id}-encounter-area`} x-model="encounterArea" class="w-full min-w-0 rounded-xl border border-border-subtle bg-bg-elevated text-text-primary p-3 text-sm font-bold focus-visible:outline-2 focus-visible:outline-action">
                    {encounterAreas.map((area) => <option value={area.id}>{area.name}</option>)}
                </select>
                {encounterAreas.map((area) => <p x-show={`encounterArea === '${area.id}'`} x-cloak class="mt-2 text-sm text-text-secondary">{area.description}</p>)}
            </div>}
            <div role="group" aria-label="Encounter version" class="flex flex-wrap items-center gap-2 mb-4">
                <span class="text-xs font-bold text-text-secondary w-full">Show encounters for:</span>
                {location.versionIds.map((version) => <button type="button" @click={`encounterVersion = '${version}'`} :aria-pressed={`encounterVersion === '${version}'`} aria-controls={`${location.id}-encounters`} class:list={['flex-1 sm:flex-none px-3 sm:px-4 py-2 rounded-xl border text-xs sm:text-sm whitespace-nowrap font-black capitalize transition focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2', version === 'red' ? 'text-red-700 dark:text-red-300' : 'text-blue-700 dark:text-blue-300']} :class={`encounterVersion === '${version}' ? 'border-action bg-action-subtle ring-1 ring-action' : 'border-border-subtle bg-bg-elevated'`}>Pokémon {version}</button>)}
            </div>
            <div id={`${location.id}-encounters`} aria-live={encounterAreas.length > 1 ? 'polite' : undefined}>
            {location.encounters.map((table) => (
                <section id={`${location.id}-${table.areaId ?? 'main'}-${table.method}-${table.versionId}-encounters`} aria-label={`Pokémon ${table.versionId} encounters${table.areaId ? ` · ${areaName(table.areaId)}` : ''}`} x-show={`encounterVersion === '${table.versionId}'${table.areaId ? ` && encounterArea === '${table.areaId}'` : ''}`} x-cloak data-encounter-version={table.versionId} data-encounter-area={table.areaId}>
                    <h4 class="font-black text-text-primary capitalize mb-3 text-sm">Pokémon {table.versionId} · {table.areaId && `${areaName(table.areaId)} · `}{table.method === 'cave' ? 'Cave' : 'Grass'}</h4>
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-5">
                        {guideEncounterCards(table).map((row) => <GuidePokemonCard name={row.name} dexId={row.dexId} levelLabel={`Lv. ${row.levels.join(', ')}`}>
                            <span class="mt-3 block w-full">
                                <span class="block text-sm font-black text-text-primary">≈{(row.weight / table.denominator * 100).toFixed(2)}%</span>
                                <span class="block text-[10px] text-text-secondary">{row.weight}/{table.denominator} encounter slots</span>
                                <span class="block h-1.5 mt-2 bg-bg-raised rounded-full overflow-hidden" aria-hidden="true"><span class="block h-full bg-action rounded-full" style={`width:${row.weight / table.denominator * 100}%`}></span></span>
                            </span>
                        </GuidePokemonCard>)}
                    </div>
                    <details class="mt-3 text-xs text-text-secondary">
                        <summary class="cursor-pointer">Exact level-by-level slots</summary>
                        <ul class="list-disc pl-5 mt-2 space-y-1">{table.slots.map((slot) => <li>{slot.name} level {slot.level}: {slot.weight}/{table.denominator}</li>)}</ul>
                    </details>
                </section>
            ))}
            </div>
        </div>}
        {location.encounters.length > 0 && <details class="mt-4 text-xs text-text-secondary">
            <summary class="cursor-pointer font-semibold">How encounter chances work</summary>
            <p class="mt-2 leading-relaxed">{location.encountersNote}</p>
        </details>}
    </details>

    {otherTrainers.length > 0 && <details class={card} x-data="{ trainersExpanded: false }" @toggle.self="trainersExpanded = $el.open" data-guide-trainers>
        <summary class={summary}><GuideSectionIcon name="trainers" />{leaders.length > 0 ? 'Other trainers' : 'Trainer parties'} ({otherTrainers.length})</summary>
        <template x-if="trainersExpanded">
        <div class="mt-4 space-y-4">
            {otherTrainers.map((trainer) => (
                <section aria-label={trainer.name} class="bg-bg-elevated rounded-xl p-3 border border-border-subtle">
                    <h4 class="font-black text-text-primary text-sm">{trainer.name}</h4>
                    {trainer.areaId && <p class="text-xs font-black text-action mt-1">{areaName(trainer.areaId)}</p>}
                    {trainer.requirements && <p class="text-sm text-text-secondary mt-2">{trainer.requirements}</p>}
                    {trainer.position && <p class="text-xs text-text-secondary mt-1">Position: ({trainer.position.x}, {trainer.position.y})</p>}
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 mt-3">
                        {trainer.party.map((member) => <GuidePokemonCard name={member.name} dexId={member.dexId} levelLabel={`Lv. ${member.level}`} moves={member.moves} />)}
                    </div>
                </section>
            ))}
        </div>
        </template>
    </details>}

    <details open={leaders.length > 0} class={card}>
        <summary class={summary}><GuideSectionIcon name="tips" />{leaders.length > 0 ? 'Battle preparation & tips' : 'Optional preparation & tips'}</summary>
        {location.starterHints?.map((hint) => <section x-show={`selectedStarter?.id === ${hint.starterDexId}`} x-cloak aria-label="Your starter's battle plan" class="mt-4 flex items-center gap-3 rounded-xl border border-action bg-action-subtle p-3">
            <GuideSprite src={guidePokemonVisual(hint.starterDexId, 1).spriteUrl} />
            <div class="min-w-0">
                <h4 class="text-xs font-black text-action uppercase tracking-wide mb-1">With your starter</h4>
                <p class="text-sm text-text-primary leading-relaxed">{hint.text}</p>
            </div>
        </section>)}
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 text-sm text-text-secondary">{location.advice.map((advice) => <li class="bg-action-subtle border border-border-subtle rounded-xl p-3 leading-relaxed">{advice.text}</li>)}</ul>
    </details>

</section>
