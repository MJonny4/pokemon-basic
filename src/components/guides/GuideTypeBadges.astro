---
interface Props { types: string[] }
const { types } = Astro.props
---

<!-- Reuse the existing type palette; text stays readable without remote icons. -->
<span class="flex flex-wrap justify-center gap-1">
    {types.map((type) => <span data-pokemon-type={type} class:list={['inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-black capitalize', `type-${type}`]}>{type}</span>)}
</span>
