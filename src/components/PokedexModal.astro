---
// Driven entirely by the Alpine `pokemon` store and window custom events.
// Import this component on any page that needs the Pokédex modal.
// The setupPokedexLoader script tag below is bundled once per page (Astro deduplicates).
---

<!-- ══════════ MODAL ══════════ -->
<div id="modal-overlay" x-data="modal" x-show="open" x-cloak @click.self="close()"
    class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-3 z-50">
    <div id="modal-box"
        class="bg-white rounded-t-2xl sm:rounded-2xl shadow-2xl w-full sm:max-w-6xl flex flex-col"
        @touchstart="onTouchStart"
        @touchmove="onTouchMove"
        @touchend="onTouchEnd"
        :style="`transform: translateY(${sheetY}px); transition: ${sheetY === 0 ? 'transform 0.3s ease' : 'none'}`">

        <!-- Drag handle (mobile only) -->
        <div class="sm:hidden flex justify-center pt-2 pb-1 shrink-0">
            <div class="w-10 h-1 rounded-full bg-slate-300"></div>
        </div>

        <!-- Banner -->
        <div class="rounded-t-2xl px-3 pt-3 pb-2 sm:px-7 sm:pt-5 sm:pb-4 shrink-0 relative overflow-hidden"
            :style="`background: linear-gradient(135deg, ${$store.pokemon.bannerColor ?? '#7c3aed'}, ${darkenColor($store.pokemon.bannerColor ?? '#7c3aed', -55)})`">
            <div class="absolute inset-0 bg-linear-to-r from-black/20 to-transparent pointer-events-none"></div>
            <button @click="close()" class="absolute top-2 right-2 sm:top-3 sm:right-3 z-50 w-8 h-8 rounded-full bg-black/25 hover:bg-black/50 text-white font-bold text-xl flex items-center justify-center transition leading-none">×</button>

            <!-- Row 1: sprite + name/types + desktop right column -->
            <div class="relative z-10 flex items-center gap-3 md:gap-5">
                <div class="shrink-0">
                    <img id="modal-sprite" :src="$store.pokemon.spriteUrl || ''" :alt="$store.pokemon.pokemon?.name"
                        class="w-14 h-14 sm:w-20 sm:h-20 md:w-28 md:h-28 object-contain drop-shadow-2xl cursor-pointer transition hover:scale-110"
                        @click="window.dispatchEvent(new CustomEvent('toggle-shiny'))" title="Click for shiny ✨">
                </div>
                <div class="flex-1 min-w-0 pr-10 md:pr-0">
                    <div class="flex items-baseline gap-2 flex-wrap mb-1.5">
                        <h2 class="text-xl sm:text-2xl md:text-3xl font-black text-white capitalize tracking-tight leading-tight" x-text="$store.pokemon.pokemon?.name ?? ''"></h2>
                        <span class="text-white/55 font-bold text-sm md:text-lg" x-text="$store.pokemon.pokemon ? '#'+String($store.pokemon.pokemon.id).padStart(3,'0') : ''"></span>
                    </div>
                    <div class="flex items-center gap-2 flex-wrap mb-1.5">
                        <div id="bannerTypes" class="flex gap-2 flex-wrap"></div>
                        <span x-show="$store.pokemon.generation"
                            class="px-2 py-0.5 rounded-full bg-white/20 border border-white/25 text-white/85 text-[10px] font-black tracking-widest uppercase"
                            x-text="$store.pokemon.generation"></span>
                    </div>
                    <div class="hidden sm:flex gap-5 flex-wrap">
                        <span class="text-white/60 text-xs font-semibold" x-text="$store.pokemon.pokemon ? `📏 ${($store.pokemon.pokemon.height/10).toFixed(1)} m` : ''"></span>
                        <span class="text-white/60 text-xs font-semibold" x-text="$store.pokemon.pokemon ? `⚖️ ${($store.pokemon.pokemon.weight/10).toFixed(1)} kg` : ''"></span>
                        <span class="text-white/60 text-xs font-semibold" x-text="$store.pokemon.pokemon ? `🧬 ${$store.pokemon.pokemon.base_experience ?? '?'} base XP` : ''"></span>
                    </div>
                </div>
                <!-- Desktop-only right badge column -->
                <div class="hidden md:flex z-10 flex-col items-end gap-2 shrink-0">
                    <button @click="window.dispatchEvent(new CustomEvent('toggle-shiny'))"
                        :class="$store.pokemon.isShiny ? 'bg-amber-400 border-amber-300 text-slate-900' : 'bg-white/20 border-white/30 text-white'"
                        class="px-3 py-1.5 rounded-lg border font-bold text-xs flex items-center gap-1.5 transition">✨ Shiny</button>
                    <div class="px-3 py-1 rounded-lg bg-white/20 border border-white/30 text-white text-xs font-bold" x-text="$store.pokemon.speedTierLabel ?? ''"></div>
                    <div class="px-3 py-1 rounded-lg bg-white/20 border border-white/30 text-white text-xs font-bold" x-text="$store.pokemon.role?.label ?? ''"></div>
                    <button x-show="$store.pokemon.pokemon" @click="addToTeam()"
                        class="px-3 py-1.5 rounded-lg border bg-emerald-500/20 border-emerald-400/50 text-white text-xs font-bold flex items-center gap-1.5 transition hover:bg-emerald-400/30 whitespace-nowrap">🧪 Add to Team</button>
                </div>
            </div>

            <!-- Row 2: mobile badge strip (hidden on md+) -->
            <div class="md:hidden relative z-10 flex items-center gap-2 flex-wrap mt-2 pt-2 border-t border-white/15">
                <button @click="window.dispatchEvent(new CustomEvent('toggle-shiny'))"
                    :class="$store.pokemon.isShiny ? 'bg-amber-400 border-amber-300 text-slate-900' : 'bg-white/20 border-white/30 text-white'"
                    class="px-2.5 py-1 rounded-lg border font-bold text-xs flex items-center gap-1 transition">✨ Shiny</button>
                <div class="px-2.5 py-1 rounded-lg bg-white/20 border border-white/30 text-white text-xs font-bold" x-text="$store.pokemon.speedTierLabel ?? ''"></div>
                <div class="px-2.5 py-1 rounded-lg bg-white/20 border border-white/30 text-white text-xs font-bold" x-text="$store.pokemon.role?.label ?? ''"></div>
                <button x-show="$store.pokemon.pokemon" @click="addToTeam()"
                    class="px-2.5 py-1 rounded-lg border bg-emerald-500/20 border-emerald-400/50 text-white text-xs font-bold flex items-center gap-1 transition hover:bg-emerald-400/30 whitespace-nowrap">🧪 Add to Team</button>
            </div>
        </div>

        <!-- Modal Quick Search -->
        <div class="px-4 py-2 bg-slate-50 border-b border-slate-100 shrink-0 relative">
            <div class="flex items-center gap-2">
                <span class="hidden sm:block text-slate-400 text-[10px] font-bold shrink-0 uppercase tracking-wide">Switch:</span>
                <!-- Mobile toggle button -->
                <button class="sm:hidden text-slate-500 hover:text-violet-600 transition shrink-0 text-xs font-bold flex items-center gap-1 px-2 py-1 rounded-lg hover:bg-violet-50"
                    @click="searchOpen = !searchOpen">
                    🔍 <span x-text="searchOpen ? 'Close' : 'Search'"></span>
                </button>
                <div class="relative flex-1" x-show="searchOpen" x-cloak>
                    <input type="text" placeholder="🔍 Search another Pokémon…"
                        x-model="modalQuery"
                        @input="onModalSearch()"
                        @keydown.enter="selectModalFirst()"
                        @keydown.escape="modalAcOpen = false"
                        @blur="setTimeout(() => modalAcOpen = false, 150)"
                        class="w-full px-3 py-1 text-xs border border-slate-200 rounded-lg focus:outline-none focus:border-violet-400 bg-white font-semibold placeholder-slate-400 transition">
                    <div x-show="modalAcOpen" x-cloak
                        class="absolute top-full left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-xl z-60 overflow-hidden">
                        <template x-for="r in modalAcResults" :key="r.id">
                            <button class="w-full text-left px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-violet-50 hover:text-violet-700 flex items-center gap-2 transition"
                                @mousedown.prevent="selectModal(r.name)">
                                <img :src="`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${r.id}.png`" :alt="r.name" class="w-7 h-7 object-contain shrink-0">
                                <span class="text-slate-400 font-mono text-[10px]" x-text="'#'+String(r.id).padStart(3,'0')"></span>
                                <span class="capitalize" x-text="r.name"></span>
                            </button>
                        </template>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="flex border-b border-slate-200 bg-white shrink-0 overflow-x-auto">
            <template x-for="tab in tabs" :key="tab.id">
                <button :class="activeTab === tab.id ? 'tab-active' : 'tab-inactive'"
                    class="flex-1 sm:flex-none px-3 sm:px-5 py-2.5 sm:py-3 font-bold text-sm whitespace-nowrap transition text-center"
                    @click="setTab(tab.id)">
                    <span x-text="tab.icon"></span>
                    <span class="hidden sm:inline ml-1" x-text="tab.shortLabel"></span>
                </button>
            </template>
        </div>

        <!-- Panel container -->
        <div id="modal-panels" x-ref="panels" class="flex-1 min-h-0 overflow-hidden">

            <!-- Loading -->
            <div class="h-full flex items-center justify-center" x-show="$store.pokemon.loading">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-violet-600 mx-auto mb-4"></div>
                    <p class="text-slate-400 font-semibold text-sm">Loading Pokédex data…</p>
                </div>
            </div>

            <!-- Overview -->
            <div class="h-full overflow-y-auto p-5" x-show="!$store.pokemon.loading && activeTab === 'overview'">
                <div id="overviewGrid" class="grid grid-cols-1 md:grid-cols-2 gap-5"></div>
            </div>

            <!-- Defense -->
            <div class="h-full overflow-y-auto p-5" x-show="!$store.pokemon.loading && activeTab === 'defense'">
                <div id="defenseContent"></div>
            </div>

            <!-- Moves -->
            <div class="h-full overflow-y-auto p-5" x-show="!$store.pokemon.loading && activeTab === 'moves'">
                <div class="flex flex-wrap items-center gap-2 mb-4 p-3 bg-slate-50 rounded-xl border border-slate-200 top-0 z-10">
                    <template x-for="f in moveFilters" :key="f.id">
                        <button :class="moveFilter === f.id ? 'fchip-active' : ''" class="fchip"
                            @click="setFilter(f.id)" x-text="f.label"></button>
                    </template>
                    <input type="text" placeholder="🔍 Filter by name…"
                        class="ml-auto px-3 py-1.5 text-xs border-2 border-slate-200 rounded-lg focus:outline-none focus:border-violet-400 font-semibold bg-white"
                        x-model="moveSearch" @input="onMoveSearch()">
                </div>
                <div class="bg-linear-to-br from-slate-50 to-emerald-50 border border-slate-200 rounded-xl p-4 mb-4">
                    <div class="flex items-center justify-between mb-2">
                        <span class="font-black text-sm text-slate-700">🗺️ Offensive Coverage</span>
                        <span class="font-black text-sm text-emerald-600" x-text="`${$store.pokemon.coverageCount} / 18 types · ${$store.pokemon.coveragePct}%`"></span>
                    </div>
                    <div class="stat-bar-track mb-3">
                        <div class="cov-fill" :style="`width:${$store.pokemon.coveragePct}%`"></div>
                    </div>
                    <div class="flex flex-wrap gap-1.5" id="coverageTypes"></div>
                </div>
                <div id="movesGrid" x-data x-effect="renderMoves($store.pokemon.moves, $store.pokemon.types, $store.pokemon.filter, $store.pokemon.search)">
                </div>
            </div>

            <!-- Trainer Tips -->
            <div class="h-full overflow-y-auto p-5" x-show="!$store.pokemon.loading && activeTab === 'trainer'">
                <div id="trainerContent"></div>
            </div>

            <!-- Compare -->
            <div class="h-full overflow-y-auto p-5" x-show="!$store.pokemon.loading && activeTab === 'compare'">
                <div id="compareContent"></div>
            </div>

        </div>
    </div>
</div>

<!-- ══════════ TEAM TOAST ══════════ -->
<div x-data="{ show: false, message: '', type: 'success' }"
    @team-toast.window="show = true; message = $event.detail.message; type = $event.detail.type; setTimeout(() => show = false, 4000)"
    x-show="show" x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-2"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-70 pointer-events-none">
    <div :class="type === 'error' ? 'bg-red-600' : 'bg-emerald-600'"
        class="text-white text-sm font-semibold px-5 py-3 rounded-2xl shadow-xl pointer-events-auto whitespace-nowrap"
        x-html="message"></div>
</div>

<script>
import { setupPokedexLoader } from '../lib/pokedex-loader'
setupPokedexLoader()
</script>
