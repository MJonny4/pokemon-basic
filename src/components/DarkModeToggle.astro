---
---
<button
    @click="$store.theme.toggle()"
    :title="$store.theme.dark ? 'Switch to light mode' : 'Switch to dark mode'"
    class="w-9 h-9 rounded-xl flex items-center justify-center border border-border bg-bg-surface text-text-secondary hover:border-action hover:text-action hover:bg-action-subtle transition-all duration-150 shrink-0"
>
    <!-- Sun icon (shown in dark mode) -->
    <svg x-show="$store.theme.dark" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
    </svg>
    <!-- Moon icon (shown in light mode) -->
    <svg x-show="!$store.theme.dark" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
</button>
