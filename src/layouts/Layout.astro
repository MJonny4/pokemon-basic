---
import '../styles/global.css'
import PokedexModal from '../components/PokedexModal.astro'

interface Props {
    title?: string
    description?: string
    /** Site-relative path (e.g. "/moves/thunderbolt") — emits canonical + og:url */
    canonicalPath?: string
}

const {
    title = 'PokeBasic — Pokédex & Type Chart',
    description = 'PokeBasic is a fast Pokémon reference tool. Look up type effectiveness, base stats, moves, and competitive tips for any Pokémon — Gens I–IX.',
    canonicalPath,
} = Astro.props

const base = import.meta.env.BASE_URL
const canonicalUrl = canonicalPath ? `${Astro.site ?? ''}${base}${canonicalPath}`.replace(/([^:])\/\//g, '$1/') : null
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content="pokemon, pokedex, type chart, type effectiveness, competitive pokemon, pokemon moves, pokemon stats" />
    <meta name="author" content="PokeBasic" />
    <meta name="robots" content="index, follow" />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${base}/icon.png`} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${base}/icon.png`} />

    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />

    <!-- Prevent dark mode flash before Alpine hydrates -->
    <script is:inline>
        (function () {
            const saved = localStorage.getItem('pb_dark')
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
            if (saved === 'true' || (saved === null && prefersDark)) {
                document.documentElement.classList.add('dark')
            }
        })()
    </script>
</head>
<body class="bg-bg-base min-h-screen transition-colors duration-200">
    <slot />
    <PokedexModal />
</body>
</html>
