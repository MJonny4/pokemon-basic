---
import '../styles/global.css'
import PokedexModal from '../components/PokedexModal.astro'
import { pwaInfo } from 'virtual:pwa-info'

interface Props {
    title?: string
    description?: string
    /** Site-relative path (e.g. "/moves/thunderbolt") — emits canonical + og:url */
    canonicalPath?: string
}

const {
    title = 'PokeBasic — Pokédex & Type Chart',
    description = 'PokeBasic is a fast Pokémon reference tool. Look up type effectiveness, base stats, moves, and competitive tips for any Pokémon — Gens I–IX.',
    canonicalPath,
} = Astro.props

const base = import.meta.env.BASE_URL
const canonicalUrl = canonicalPath ? `${Astro.site ?? ''}${base}${canonicalPath}`.replace(/([^:])\/\//g, '$1/') : null
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content="pokemon, pokedex, type chart, type effectiveness, competitive pokemon, pokemon moves, pokemon stats" />
    <meta name="author" content="PokeBasic" />
    <meta name="robots" content="index, follow" />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${base}/icon.png`} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${base}/icon.png`} />

    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <meta name="theme-color" content="#FF3B30" />

    <!-- Prevent dark mode flash before Alpine hydrates -->
    <script is:inline>
        (function () {
            let saved = null
            try { saved = localStorage.getItem('pb_dark') } catch { /* Fall back to the system theme. */ }
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
            if (saved === 'true' || (saved === null && prefersDark)) {
                document.documentElement.classList.add('dark')
            }
        })()
    </script>
</head>
<body class="bg-bg-base min-h-screen transition-colors duration-200">
    <slot />
    <PokedexModal />
    <aside data-pwa-update hidden role="status" aria-live="polite" class="fixed bottom-4 right-4 z-[100] max-w-sm mx-4 p-4 rounded-xl border border-border bg-bg-surface text-text-primary shadow-lg">
        <p class="text-sm font-semibold">An update is ready</p>
        <p class="mt-1 text-xs text-text-secondary">Finish or save your changes first. Reloading updates all open PokeBasic tabs.</p>
        <div class="mt-3 flex gap-3">
            <button data-pwa-reload type="button" class="rounded-lg bg-action px-3 py-2 text-sm text-white disabled:opacity-50">Reload to update</button>
            <button data-pwa-later type="button" class="rounded-lg border border-border px-3 py-2 text-sm">Later</button>
        </div>
    </aside>
    <script>
        import '../pwa'
    </script>
</body>
</html>
